@model JobPortal.Domain.Models.Job
@{
    Layout = "/Views/Shared/_LayoutEmployer.cshtml";
    ViewBag.Title = "Edit Job";
}
<h2>Edit Job</h2>
 

 

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Skills</label><br />
        @foreach (var skill in ViewBag.Skills)
        {
            <input type="checkbox" name="selectedSkills" value="@skill.Id"
                   @(Model.JobSkills.Any(js => js.SkillId == skill.Id) ? "checked" : "") />
            @skill.Name <br />
        }
    </div>

    <div class="form-group">
        <label asp-for="StateId"></label>
        <select asp-for="StateId" asp-items="@(new SelectList(ViewBag.States, "Id", "Name"))" class="form-control"></select>
    </div>

    <div class="form-group">
        <label asp-for="DistrictId"></label>
        <select asp-for="DistrictId" asp-items="@(new SelectList(ViewBag.Districts, "Id", "Name"))" class="form-control"></select>
    </div>

    <div class="form-group">
        <label asp-for="ClosingDate"></label>
        <input asp-for="ClosingDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Positions"></label>
        <input asp-for="Positions" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="MyJobs" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
    <script>
        // AJAX to load districts when state changes
        $("#StateId").change(function () {
            var stateId = $(this).val();
            $.getJSON('https://localhost:60482/Location/GetDistricts/' + stateId, function (data) {
                var districtSelect = $("#DistrictId");
                districtSelect.empty();
                $.each(data, function (i, district) {
                    districtSelect.append($('<option>', {
                        value: district.id,
                        text: district.name
                    }));
                });
            });
        });
    </script>
}