@model JobPortal.Domain.Models.Job
@{
    Layout = "/Views/Shared/_LayoutEmployer.cshtml";
    ViewBag.Title = "New Job Posting";

}
<h2>Create Job</h2>




<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="@Model.Title" ></label>
        <input asp-for="@Model.Title" id="Title" name="Title"  class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="@Model.Description"></label>
        <textarea asp-for="@Model.Description" id="Description" name="Description"  class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Skills</label><br />
        

         <select class="ddlselect form-select" id="selectedSkills" name="selectedSkills" multiple="multiple">
             @foreach (var skill in ViewBag.Skills)
                {
                 <option value="@skill.Id">@skill.Name</option>
             
                }         
          </select>
    </div>

    <div class="form-group">
        <label asp-for="@Model.JobType">Job Type</label>
        <select asp-for="JobType" id="JobType" name="JobType"  class="form-control">
            <option value="Remote">Remote</option>
            <option value="Office">Office</option>
            <option value="Hybrid">Hybrid</option>
        </select>
    </div>

    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="@Model.MinSalary">Salary (Min)</label>
            <input asp-for="@Model.MinSalary" id="MinSalary" name="MinSalary"  type="number" class="form-control" />
        </div>
        <div class="form-group col-md-6">
            <label asp-for="@Model.MaxSalary">Salary (Max)</label>
            <input asp-for="@Model.MaxSalary" id="MaxSalary" name="MaxSalary"   type="number" class="form-control" />
        </div>
    </div>

    <div class="form-group">
        <label asp-for="@Model.Positions">No. of Positions</label>
        <input asp-for="@Model.Positions" id="Positions" name="Positions"   type="number" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="@Model.ExpiryAt">Closing Date</label>
        <input asp-for="@Model.ExpiryAt" id="ExpiryAt" name="ExpiryAt"  type="date" class="form-control" />
    </div>

    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="StateId">State</label>
            <select asp-for="@Model.StateId" id="StateId" name="StateId"   class="form-control" >
                 <option value="0">--Select--</option>
                @foreach(var itm in  ViewBag.States )
                {
                    <option value="@itm.Id">@itm.Name</option>
                }
            </select>
        </div>
        <div class="form-group col-md-6">
            <label asp-for="CityId">District</label>
            <select  asp-for="@Model.CityId" id="CityId" name="CityId"    class="form-control">
                <option value="">--Select State first--</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="MyJobs" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
         $(document).ready(function () {
            $('.ddlselect').select2();
        });
        // AJAX to load districts when state changes
        $("#StateId").change(function () {
            var stateId = $(this).val();
            
            $.getJSON('/Location/GetCities/?stateId=' + stateId, function (data) {
                var districtSelect = $("#CityId");
                districtSelect.empty();
                 districtSelect.append($('<option>', {
                        value: "0",
                        text: "--Select--"
                    }));
                $.each(data, function (i, district) {
                    districtSelect.append($('<option>', {
                        value: district.id,
                        text: district.name
                    }));
                });
            });
        });
    </script>
}
