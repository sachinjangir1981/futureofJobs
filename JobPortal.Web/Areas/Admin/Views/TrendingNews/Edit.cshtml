@using JobPortal.Models;
@model WpPost
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">
@using (Html.BeginForm("Edit", "TrendingNews", FormMethod.Post, new { id = "frmForm", @enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4> Add/Edit Post</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row">
            <div class="col-md-12">
                @Html.HiddenFor(model => model.PKID)
                @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "form-label" })

                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", @type = "numeric" } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })




            </div>

        </div>



        <div class="row" style="padding-top:30px">
            <div class="col-md-12">
                @Html.LabelFor(model => model.PostContent, htmlAttributes: new { @class = "form-label" })

                @Html.TextAreaFor(model => model.PostContent,  new { @class = "form-control summernote"   })
                @Html.ValidationMessageFor(model => model.PostContent, "", new { @class = "text-danger" })

            </div>


        </div>
        <div class="row" style="padding-top:30px">
            <div class="col-md-6">

                Category

                <select id="CategoryId" name="CategoryId">
                    @foreach (var itm in ViewBag.CategoryList)
                    {
                        if (Model.CategoryId == itm.PKID)
                        {
                            <option value="@itm.PKID" selected="selected">@itm.CatName</option>
                        }
                        else
                        {
                            <option value="@itm.PKID">@itm.CatName</option>
                        }
                    }
                </select>

            </div>

            <div class="col-md-3">
                <br />

                Active

                @Html.CheckBoxFor(m => m.IsActive)
            </div>
        </div>
        <div class="row" style="padding-top:30px">
            <div class="col-md-4">
                Source

                @Html.EditorFor(m => m.OSource, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="col-md-4">

                Post Date

                @Html.EditorFor(m => m.PostDate, new { htmlAttributes = new { @class = "form-control", @type = "datetime-local" } })

            </div>
            <div class="col-md-4">

                Display Order

                @Html.EditorFor(m => m.DisplayOrder, new { htmlAttributes = new { @class = "form-control", @type = "number" } })

            </div>
            <div class="col-md-4">
                <br />

                Cover Image
                <input type="file" name="fCoverPhoto" id="fCoverPhoto" />
                <img src="/images/snippet/@Model.CoverImage" width="100" />
                @Html.HiddenFor(m => m.CoverImage)
            </div>
        </div>
        <div class="row" style="padding-top:30px">

            <div class="col-md-6">
            </div>
        </div>
        <div class="row" style="padding-top:30px">
            <div class="col-md-12">

                <input id="btnSubmit" type="submit"   value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

@section Scripts
{
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="/js/summernote-bs4.min.js"></script>
<script src="/js/summernote-local.js"></script>
}