@using JobPortal.Models;
@model List<WpPost>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div style="float:right">
    <a href="/admin/TrendingNews/Create" class="btn btn-primary">Create Post</a>

</div>

<div>
    <form id="frm" name="frm" method="post" action="/admin/trendingnews/Index">
    <select id="id" name="id" onchange="getpostById()">
        @foreach (var itm in ViewBag.CategoryList)
        {
            if (ViewBag.SelectedCategory == itm.PKID)
            {
                    <option value="@itm.PKID" selected="selected">@itm.CatName</option>
            }
            else
            {
                    <option value="@itm.PKID">@itm.CatName</option>
            }
        }
    </select>
    
    </form>
</div>

<table id="myTable" class="table">

    <tr>
        <th width="50px">SNO</th>
        <th>Title</th>
        <th width="100px">View</th>
        <th width="100px">Edit</th>
        <th width="100px">Delete</th>
    </tr>

    @foreach (var itm in Model)
    {
        <tr>
            <td width="50px">@itm.RNUM</td>
            <td>@itm.Title</td>
            <td width="100px"><a href="/visitor/trendingnews/@itm.PKID" target="_blank">View</a> </td>
            <td width="100px"><a href="/admin/trendingnews/Edit/@itm.PKID" class="btn"> Edit</a> </td>
            <td width="100px"><button onclick="DeletePost(@itm.PKID)">Delete</button> </td>
        </tr>
    }

</table>
<script>

    $(document).ready(function () {
        $('.navbar-brand').removeClass("active");
        $('#atnews').addClass("active");
    });

    function getpostById()
    {
        $('#frm').submit();
    }

    function DeletePost(id) {
        if (confirm('Are you sure to delete this news?')) {
            $.ajax({
                type: "POST",
                url: "/admin/trendingnews/Delete",
                data: "id=" + id,
                dataType: "json",
                success: function (data) {
                    window.location.reload();
                },
                error: function () {
                    console.log("error");
                }
            });
        }
    }

</script>
