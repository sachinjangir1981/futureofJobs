@using JobPortal.Web.Models;
@model List<OneMinuteItem>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int i = 0;
}


<div style="float:right">
    <a href="/admin/TimePass5Line/Create" class="btn btn-primary">Create</a>

</div>
<table>
    <tr>
        <td>
            <form id="frm" method="get" action="/admin/TimePass5Line/Index">
                @Html.DropDownList("id", new SelectList(ViewBag.ParentCategories, "PKID", "Path"), new { @class = "form-control", @onchange = "submitform()" })
            </form>
        </td>
    </tr>
</table>
<table id="myTable" class="table">
    <thead>
        <tr>
            <th width="40">SNO</th>
            <th>Interesting Snippet</th>
            <th>Card</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var itm in Model)
        {
            i++;
            <tr>
                <td width="40">@i </td>
                <td>@Html.Raw(itm.NewsSubject)</td>

                <td><a href="/visitor/TimePass/@itm.PKID" class="btn btn-info">Create Card</a> </td>
                <td><a href="/admin/TimePass5Line/Edit/@itm.PKID" class="btn btn-success">Edit</a> </td>
                <td><a href="javascript:void(0);" onclick="javascript:deleteCustomer(@itm.PKID);" class="btn btn-danger">Delete</a> </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {

    <script>

        function deleteCustomer(id) {
            if (confirm("Are you sure you want to delete this timepass article?")) {
                $.ajax({
                    type: "POST",
                    url: "/admin/TimePass5Line/Delete",
                    data: "id=" + id,
                    dataType: "json",
                    success: function (data) {
                        window.location.reload();
                    },
                    error: function () {
                        console.log("error");
                    }
                });
            }
        }


        function submitform()
        {
           document.getElementById("frm").submit();
        }

    </script>
}