@using JobPortal.Web.Models;
@model LibraryModel
@{
    Layout = "_LayoutAdmin";

}
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">

@using (Html.BeginForm("Edit", "Library", FormMethod.Post, new { id = "frmFormpaper", @enctype = "multipart/form-data" }))
{



    <div class="form-horizontal" style="padding:15px">
        <h4> Add/Edit Library</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @if (!string.IsNullOrEmpty(ViewBag.msg))
        {
            <div class="alert-success">
                @ViewBag.msg
            </div>
        }
        <div class="row">
            <div class="col-12">
                @Html.HiddenFor(model => model.PKID)
                Title
                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })

            </div>

            <div class="col-12">
                
                Category
                @Html.DropDownList("CategoryId", new SelectList(ViewBag.ParentCategories, "PKID", "Path", Model.CategoryId), new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })

            </div>
           
            <div class="col-12">

                Content
                @Html.TextAreaFor(model => model.Content, new { @class = "form-control summernote", @rows = "5", @cols = "50" })
                @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })

            </div>

            <div class="col-12">
                @Html.HiddenFor(model => model.ImageUrl)
                Image
                <input type="file" id="flImageUrl" name="flImageUrl" accept="image/*" />
                <img src="~/images/library/@Model.ImageUrl" width="100" />
            </div>
            <div class="col-3">

                Display Order
                @Html.EditorFor(model => model.DisplayOrder, new { htmlAttributes = new { @class = "form-control", @type = "number"} })
                @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })

            </div>, 
            <div class="col-2">

                Level 1
                @Html.EditorFor(model => model.Level1, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })

            </div>
            <div class="col-2">

                Level 2
                @Html.EditorFor(model => model.Level2, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })

            </div>
            <div class="col-2">

                Level3
                @Html.EditorFor(model => model.Level3, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })

            </div>
            <div class="col-3">
            </div>
        </div>




       

        <div class="row" style="padding-top:30px">
            <div class="col-md-12">

                <input id="btnSubmitContent" type="submit" value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

