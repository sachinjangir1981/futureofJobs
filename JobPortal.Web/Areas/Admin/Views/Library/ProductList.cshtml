@using JobPortal.Web.Models;
@model List<LibraryModel>
@{
    int i = 0;
   
}
<table width="100%">
    <tr>
        <th width="100px">SNO</th>
        <th>Title</th>
        <th width="100px">Copy</th>
        <th width="80px">Edit</th>
        <th width="80px">Duplicate</th>
        <th width="80px">Delete</th>
    </tr>

@foreach (var itm in Model)
{
    
     
        <tr>
            <td width="100px">@ViewBag.CatSNO@itm.DisplayOrder</td>
            <td>@itm.Title </td>
            <td width="100px"><button class="btn copylink" id="btn_@itm.PKID" onclick="copywithJquery('btn_@itm.PKID','dvlnk_@itm.PKID')">Copy Link</button> <div name="dvlnk_@itm.PKID" style="display:none" id="dvlnk_@itm.PKID"> <a href="https://hellokisan.org/visitor/library/@itm.PKID">@itm.Title</a></div> </td>
            <td width="80px"><a href="/admin/Library/Edit/@itm.PKID" class="btn btn-primary"> Edit</a> </td>
            <td width="80px"><button onclick="DuplicateItem(@itm.PKID, @itm.CategoryId)" class="btn btn-warning">Duplicate</button> </td>
            <td width="80px"><button onclick="Deleteitem(@itm.PKID)" class="btn btn-secondary">Delete</button> </td>
        </tr>
    
    
}
</table>
