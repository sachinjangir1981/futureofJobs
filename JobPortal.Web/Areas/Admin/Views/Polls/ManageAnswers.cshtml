@using JobPortal.Models;
@model List<Answers>
@{
    ViewBag.Title = "ManageAnswers";
    Layout = "_LayoutAdmin";
}
@{

    int i = 0;
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">
 
<div class="row">
    <div class="col-lg-12 col-md-12">

      <b>Question: </b>  @Html.Raw(ViewBag.Question.Question)
    </div>
</div>
<div class="row">


    <div class="col-lg-12 col-md-12" style="width:100%;display:flex">


        <table id="myTable" class="table">
            <thead>
                <tr>
                    <th width="20px">SNO</th>
                    <th>Answer</th>

                    <th width="60px">Display Order</th>
                    <th width="60px">Edit</th>
                    <th width="60px">Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var itm in Model)
                {
                    i = i + 1;
                    <tr>
                        <td>@i</td>
                        <td><textarea id="txtAnswer_@itm.PKID" class="form-control spnote summernote">@itm.Answer </textarea> </td>
                        <td width="60px"><input id="txtDisplay_@itm.PKID" type="number" value="@itm.DisplayOrder" class="form-control" /></td>
                        <td width="60px"><input type="button" class="btn" value="Update" onclick="UpdateForm('txtAnswer_@itm.PKID','txtDisplay_@itm.PKID',@itm.PKID)" /> </td>
                        <td width="70px"><input type="button" class="btn" value="Delete" onclick="Delete(@itm.PKID)" /> </td>

                    </tr>

                }

            </tbody>
        </table>

    </div>
</div>
<div class="row">
    <form id="frmUpdateAnswer" asp-action="UpdateAnswerList" asp-controller="Polls" method="post">
    
        <input type="hidden" id="hidAnswer" name="hidAnswer" value="" />
        <input type="hidden" id="hidPKID" name="hidPKID" value="0" />
        <input type="hidden" id="hidQuestionId" name="hidQuestionId" value="0" />
        <input type="hidden" id="hidDisplayOrder" name="hidDisplayOrder" value="0" />

     </form>
</div>
<div class="row">
    <form id="frmForm" asp-action="ManageAnswers" asp-controller="Polls" method="post">
    @{
        i = i + 1;}
        <table class="table" width="100%">
            <tr>
                <td colspan="2">
                    <textarea id="Answer" name="Answer" class="form-control summernote"></textarea>

                     
                    <input type="hidden" id="QuestionId" name="QuestionId" value="@ViewBag.QuestionId" />
                </td>


            </tr>
            <tr>
                <td width="100px"><input id="DisplayOrder" name="DisplayOrder" type="number" value="@i" class="form-control" /></td>
                <td align="left"><input type="submit" id="btnSubmit"    class="btn-primary" value="Save" /> </td>
            </tr>

        </table>
    
    </form>
</div>
@section Scripts {

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="~/js/summernote-bs4.min.js"></script>
    <script src="~/js/summernote-local.js"></script>
<script>
    $(document).ready(function () {
        
        
        // $('.spnote').each(function (i, obj) {
        //     $('#' + obj.id).summernote('code', $('#' + obj.id).val());
        // });
        $('.navbar-brand').removeClass("active");
        $('#apoll').addClass("active");
        // $('#btnSubmit').click(function () {
        //     var content = $('#AnswerCT').summernote('code');
        //     $('#Answer').val(content);

             
        //     $("#frmForm").submit();
        //     // Do something with the content, e.g., send it to the server
        // });
    });
</script>
<script>
    $(document).ready(function () {
       
    });

    function UpdateForm(txtAnswer, txtDisplay, id) {
        
           console.log($('#' + txtAnswer).val());
        $('#hidAnswer').val($('#' + txtAnswer).val());
        $('#hidPKID').val(id);
        $('#hidDisplayOrder').val($('#' + txtDisplay).val());
        $('#hidQuestionId').val(@ViewBag.Question.PKID);
         $('#frmUpdateAnswer').submit();
    }

    function Update(txtAnswer, txtDisplay, id) {
        if (confirm("Are you sure to update?")) {
           
            $.ajax({
                type: "POST",
                url: "/Admin/Polls/UpdateAnswer",
                data: "id=" + id + "&answer=" + JSON.stringify( $('#' + txtAnswer).val() )+ "&displayorder=" + $('#' + txtDisplay).val(),
                dataType: "json",
                success: function (data) {
                    alert("Updated");
                },
                error: function () {
                    console.log("error");
                }
            });
        }
    }

    function Delete(id) {
        if (confirm("Are you sure to delete?")) {
            $.ajax({
                type: "POST",
                url: "/Admin/Polls/DeleteAnswer",
                data: "id=" + id,
                dataType: "json",
                success: function (data) {
                    window.location.reload();
                },
                error: function () {
                    console.log("error");
                }
            });
        }
    }

    
</script>
}