@using JobPortal.Models;
@model List<Questions>
@{
    ViewBag.Title = "Index";
    Layout = "_LayoutAdmin";
}
@{
    int i = 0;
}
<div class="row">
    <div style="float:right;text-align:right">
        <a href="/Admin/Polls/ManageQuestion" class="btn btn-outline-primary">Create Question </a>
    </div>
</div>
<div class="row" style="padding:5px 5px 5px 5px">
    <div>
        @Html.DropDownList("ddlCategory", new List<SelectListItem>(ViewBag.CategoryList), htmlAttributes: new { @class = "form-control", @onchange = "pagereloadwithcategoryId()" })
    </div>
</div>
<div class="row">


    <div class="col-lg-12 col-md-12 table-bordered" style="width:100%;display:flex">


        <table id="myTable" class="table">
            <thead>
                <tr>
                    <th width="20px">SNO</th>
                    <th>Question</th>
                    <th width="200px">Display Order</th>
                    <th width="200px">Change Category</th>
                    <th width="60px">Active</th>
                    <th width="60px">Answers</th>
                    <th width="60px">Edit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var itm in Model)
                {
                    i = i + 1;
                    var dvId = "dv" + itm.PKID.ToString();
                    <tr>
                        <td>@i</td>
                        <td><div id="@dvId">@Html.Raw(itm.Question)</div> </td>
                        <td width="260px"><input type="text" id="txtDisplay_@itm.PKID" value="@itm.DisplayOrder" /><input type="button" value="update" onclick="UpdateDisplayOrder(@itm.PKID)" /> </td>
                        <th width="200px"><input type="button" onclick="openPopup('@dvId',@itm.PKID, '@itm.CategoryNames',@itm.CategoryId)" value="Change Category" /> </th>
                        <td width="60px">
                            @if (itm.IsActive)
                            {
                                <span class="badge bg-success" style="background-color:green">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger" style="background-color:red">Inactive</span>
                            }
                        </td>
                        <td width="60px"><a href="/Admin/polls/ManageAnswers/@itm.PKID" class="btn">Edit</a> </td>
                        <td width="70px"><a href="/Admin/Polls/ManageQuestion/@itm.PKID" class="btn">Edit</a>  </td>

                    </tr>

                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal" id="exampleModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" style="padding:25px" role="document">
        <div class="modal-content">
            <div class="row" style="padding:20px">
                <div class="col-lg-12">
                    <input type="hidden" id="hidQuestionId" value="0" /> 
                    <input type="hidden" id="hidCategoryId" value="0" />
                    <div id="dvQuestion"></div>
                    <div><b>Old Category: </b> <div id="dvOldCategory"></div></div>
                    <div id="dvNewCategory">
                        <b>New Category: </b>  @Html.ListBox("ddlNewCategory", new List<SelectListItem>(ViewBag.CategoryList), htmlAttributes: new { @class = "form-control", @style="min-height:250px" })
                    </div>
                    <div>
                        <br />
                        <input type="button" value="Save" onclick="UpdateToNewCategory()" class="btn btn-info" />
                        <input type="button" value="Close" onclick="javascript:$('#exampleModal').modal('hide');" class="btn btn-info" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>

<script>


    $(document).ready(function () {
        // $('#myTable').dataTable();
        $('.navbar-brand').removeClass("active");
        $('#apoll').addClass("active");
    });

    function Activate(id) {
        if (confirm("Are you sure?")) {
            $.ajax({
                type: "POST",
                url: "/Admin/Polls/QuestionActivate",
                data: "id=" + id,
                dataType: "json",
                success: function (data) {
                    window.location.reload();
                },
                error: function () {
                    console.log("error");
                }
            });
        }
    }

    function openPopup(dvid, questionId, categoryName, categoryId) {
        $('#dvQuestion').html($('#' + dvid).html());
        $('#dvOldCategory').html(categoryName);
        $('#hidQuestionId').val(questionId);
        $('#hidCategoryId').val(categoryId);
        $("#exampleModal").modal("show");
    }

    function pagereloadwithcategoryId() {
        var id = $('#ddlCategory').val();
        location.href = "/Admin/Polls/index/" + id;
    }

    function UpdateDisplayOrder(questionId) {
        var DisplayOrder = $("#txtDisplay_" + questionId).val();
        var categoryId = $('#ddlCategory').val();
        if (isNaN(DisplayOrder)) {
            DisplayOrder = 0;
        }
        $.ajax({
            type: "POST",
            url: "/Admin/Polls/UpdateDisplayOrder",
            data: "id=" + categoryId + "&questionId=" + questionId + "&displayorder=" + DisplayOrder,
            dataType: "json",
            success: function (data) {

            },
            error: function () {
                console.log("error");
            }
        });
    }


    function UpdateToNewCategory() {
        var QuestionId = $("#hidQuestionId").val();
        var CategoryId = $('#hidCategoryId').val();
        var NewCategoryId = $('#ddlNewCategory').val();
        
        $.ajax({
            type: "POST",
            url: "/Admin/Polls/UpdateToNewCategory",
            data: "questionId=" + QuestionId + "&categoryId=" + CategoryId + "&newCategoryId=" + NewCategoryId,
            dataType: "json",
            success: function (data) {
                window.location.reload();
                
            },
            error: function () {
                console.log("error");
            }
        });
    }

</script>
