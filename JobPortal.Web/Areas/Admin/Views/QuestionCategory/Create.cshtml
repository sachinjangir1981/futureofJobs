@using JobPortal.Models;
@model Questionnaires
@{
    Layout = "_LayoutAdmin";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">

@using (Html.BeginForm("Create", "QuestionCategory", FormMethod.Post, new { id = "frmFormpaper", @enctype = "multipart/form-data" }))
{



    <div class="form-horizontal" style="padding:15px">
        <h4> Add Poll Category</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @if (!string.IsNullOrEmpty(ViewBag.msg))
        {
            <div class="alert-success">
                @ViewBag.msg
            </div>
        }
        <div class="row">
            <div class="col-md-6">
                @Html.HiddenFor(model => model.PKID)
                Questionaire
                @Html.EditorFor(model => model.Questionaire, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Questionaire, "", new { @class = "text-danger" })

            </div>
            <div class="col-md-6">
                Sub Heading
                @Html.EditorFor(model => model.SubHeading, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.SubHeading, "", new { @class = "text-danger" })

            </div>
            <div class="col-md-6">
                Details
                @Html.TextAreaFor(model => model.Details, new { @class = "form-control summernote", @rows = 5, @cols = "50" })
                @Html.ValidationMessageFor(model => model.Details, "", new { @class = "text-danger" })

            </div>
            <div class="col-md-6">
                @Html.HiddenFor(model => model.ImageUrl)
                Image
                <input type="file" id="flImageUrl" name="flImageUrl" class="form-control" accept="image/*" />

            </div>
            <div class="col-md-6">
                Display Order
                @Html.EditorFor(model => model.DisplayOrder, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })

            </div>


            <div class="col-md-6">
                Link Text
                @Html.EditorFor(model => model.ActionText, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ActionText, "", new { @class = "text-danger" })

            </div>
            <div class="col-md-6">
                @Html.HiddenFor(model => model.BGImage)
                Background Image
                <input type="file" id="flBgImageUrl" name="flBgImageUrl" accept="image/*" />
                <img src="@Url.Content("~/images/polls/" + Model.BGImage)" alt="Image" style="width: 100px; height: 100px;" />
            </div>
            <div class="col-md-6">
                Background Color
                @Html.EditorFor(model => model.BGColor, new { htmlAttributes = new { @type = "color" } })
                @Html.ValidationMessageFor(model => model.ActionText, "", new { @class = "text-danger" })

            </div>
            <div class="col-md-6">

                Active
                @Html.CheckBoxFor(model => model.IsActive)

            </div>
        </div>





        <div class="row" style="padding-top:30px">
        </div>

        <div class="row" style="padding-top:30px">
            <div class="col-md-12">

                <input id="btnSubmitContent" type="submit" value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/summernote-bs4.min.js"></script>
    <script src="~/js/summernote-local.js"></script>
             }