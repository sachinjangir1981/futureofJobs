@using JobPortal.Models;
@model List<Questionnaires>
@{
    Layout = "_LayoutAdmin";
    ViewBag.Title = "Index";
    int i = 0;

}
<div style="float:right">
    <a href="/Admin/QuestionCategory/Create" class="btn btn-outline-primary">Create New Category</a>

</div>

<table id="myTable" class="table">

    <tr>
        <th width="50px">SNO</th>
        <th>Category</th>
        <th width="80px">Active</th>
        <th width="70px">Edit</th>
        <th width="70px">Delete</th>
    </tr>

    @foreach (var itm in Model)
    {
        i += 1;
        <tr>
            <td width="50px">@i</td>

            <td>@itm.Questionaire </td>
           
            <td width="80px">
                @if (itm.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </td>

            <td width="70px"><a href="/Admin/QuestionCategory/Edit/@itm.PKID" class="btn btn-primary"> Edit</a> </td>
            <td width="70px"><button onclick="DeleteCategory(@itm.PKID)" class="btn btn-warning">Delete</button> </td>
        </tr>
    }

</table>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>

    $(document).ready(function () {
        $('.navbar-brand').removeClass("active");
        $('#atnews').addClass("active");
    });



    function DeleteCategory(id) {
        if (confirm('Are you sure to delete this cagegory?')) {
            $.ajax({
                type: "POST",
                url: "/Admin/QuestionCategory/Delete",
                data: "id=" + id,
                dataType: "json",
                success: function (data) {
                    window.location.reload();
                },
                error: function () {
                    console.log("error");
                }
            });
        }
    }

</script>