@model JobPortal.Domain.Models.Skill
@{
    ViewData["Title"] = "Edit Skill";
    Layout = "_LayoutAdmin";
}

<h2>Add Skill</h2>

<form asp-action="Edit" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="SkillCategoryId" class="form-label">Category</label>
        <select asp-for="SkillCategoryId" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>
    <div class="mb-3">
        <label asp-for="IsActive" class="form-label">Active</label>
        <input asp-for="IsActive" class="form-checkbox" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
