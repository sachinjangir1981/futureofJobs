@using JobPortal.Web.Models;

@model DynamicForm
@{
    ViewBag.Title = "Question";
    Layout = "~/Views/Shared/_LayoutVisitor.cshtml";
 
    int currentSection = ViewBag.CurrentSection;
    int currentQuestion = ViewBag.CurrentQuestion;
    string borderWidth = "1px";
    int iQuestionCounter = 0;
    string activeQuestionClass = "tbl";

    string SurveyFormatHeaderBG = "background-color:" + Model.CommonCSS.SurveyFormatHeaderBG ?? "#ffffff";
    string SurveyFormatHeadDetailsBG = "background-color:" + Model.CommonCSS.SurveyFormatHeadDetailsBG ?? "#ffffff";
    string SurveyFormatFooterBG = "background-color:" + Model.CommonCSS.SurveyFormatFooterBG ?? "#ffffff";
    string SurveyFormatSectionBG = "background-color:" + Model.CommonCSS.SurveyFormatSectionBG ?? "#ffffff";
    string SurveyFormatSectionDetailsBG = "background-color:" + Model.CommonCSS.SurveyFormatSectionDetailsBG ?? "#ffffff";
    string SurveyFormatSectionFooterBG = "background-color:" + Model.CommonCSS.SurveyFormatSectionFooterBG ?? "#ffffff";
    string QuestionBG = "background-color:" + Model.CommonCSS.QuestionBG ?? "#ffffff";
    string AnswerBG = "background-color:" + Model.CommonCSS.AnswerBG ?? "#ffffff";
}


<script src="https://code.jquery.com/jquery-3.7.0.min.js" integrity="sha256-2Pmvv0kuTBOenSvLm6bvfBSSHrUJ+3A7x6P5Ebd07/g=" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" type="text/javascript"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">

<link href="~/css/radiobtncss.css" rel="stylesheet" />

<link href="~/css/forms.css" rel="stylesheet" />
<style>
    body {
        font-size: 14px;
    }
    input[type=checkbox]
{
  /* Double-sized Checkboxes */
  -ms-transform: scale(2); /* IE */
  -moz-transform: scale(2); /* FF */
  -webkit-transform: scale(2); /* Safari and Chrome */
  -o-transform: scale(2); /* Opera */
  transform: scale(2);
  padding: 10px;
}

/* Might want to wrap a span around your checkbox text */
.checkboxtext
{
  /* Checkbox text */
  font-size: 110%;
  display: inline;
}
    
</style> 
@if (Model != null)
{
    <div class="container">
        <div class="row" style="padding-left:0px;margin-left:0px">
            <table>
                <tr>
                    <td colspan="2">
                        <table>
                            <tr>
                                <td>
                                    <input type="button" onclick="SaveForm(1);" value="Save Form" style="background-color:burlywood" />
                                </td>
                                <td>
                                    <input type="button" onclick="SaveForm(2);" value="Save Survey Question Series" class="sheetbg" />
                                </td>


                                <td>
                                    <input type="button" onclick="AddNewSection();" value="Add.New Survey Question Series" />
                                </td>

                                <td>
                                    <a href="/visitor/forms/@Model.PKID" class="btn btn-primary"> View</a>
                                </td>
                                <td>
                                    <a href="/Admin/QuestionForms/index" class="btn btn-primary"> Back</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td width="400px" valign="top">
                        @using (Html.BeginForm("ManageForm", "QuestionForms", FormMethod.Post, new { id = "frmFormSheetUpdate", @enctype = "multipart/form-data" }))
                        {
                            <table class="tbl" width="100%" style="border:1px solid #000; padding:0px 0px 0px 0px">
                                <tr>
                                    <td colspan="2" class="sheetheading" style="@SurveyFormatHeaderBG">
                                        @Html.HiddenFor(model => model.PKID)
                                        @Html.HiddenFor(model => model.SectionId)
                                        <input type="hidden" id="hidType" name="hidType" value="1" />
                                        @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control sheetheading", @placeholder = "Form Title" } })
                                    </td>
                                </tr>


                                <tr style="@SurveyFormatSectionBG">
                                    <td colspan="2" class="heading"> @Html.EditorFor(model => model.CurrentSection.Section, new { htmlAttributes = new { @class = "form-control heading", @style = @SurveyFormatSectionBG, @placeholder = "Survey Question Series Heading", @required = "required" } })</td>
                                </tr>
                                <tr style="@SurveyFormatSectionDetailsBG">
                                    <td colspan="2" > @Html.TextAreaFor(Model => Model.CurrentSection.Detail, new { @class = "form-control summernote", @rows = "5", cols = "50", @placeholder = "Line 1" }) </td>
                                </tr>
                                <tr>
                                    <td class="sheetbg">Screen</td>
                                    <td class="subheading">@Html.EditorFor(model => model.CurrentSection.Screen, new { htmlAttributes = new { @class = "form-control subheading", @placeholder = "Screen", @min = "1", @style = "background-color:#9ACBD0" } })</td>
                                </tr>
                                <tr>
                                    <td class="sheetbg">Display Order</td>
                                    <td class="note"> @Html.EditorFor(Model => Model.CurrentSection.DisplayOrder, new { htmlAttributes = new { @class = "form-control note sheetbg", @min = "1", @placeholder = "Display Order" } })</td>
                                </tr>
                                <tr>
                                    <td class="sheetbg">Active</td>
                                    <td class="note">@Html.CheckBoxFor(model => model.CurrentSection.IsActive, new { htmlAttributes = new { @class = "form-control note", @placeholder = "Note", @style = "background-color:#9ACBD0" } }) </td>
                                </tr>

                                <tr>
                                    <td colspan="2">
                                        @Html.Partial("_AddEditQuestion", Model)
                                    </td>

                                </tr>

                                <tr style="@SurveyFormatSectionFooterBG">

                                    <td colspan="5"><b>Survey Question Series Footer:</b>@Html.TextAreaFor(model => model.CurrentSection.Footer, new { @class = "form-control", @placeholder = "Survey Question Series Footer Note" }) </td>

                                </tr>
                                <tr style="@SurveyFormatFooterBG">

                                    <td colspan="5"><b>Form Footer:</b>@Html.TextAreaFor(model => model.Footer, new { @class = "form-control", @placeholder = "Form Footer Note", @style = @SurveyFormatFooterBG }) </td>

                                </tr>
                            </table>
                        }
                    </td>
                    <td width="500px" valign="top">
                        <div style="max-height:600px;overflow-y:auto">
                            @if (Model.PKID > 0)
                            {
                                int isectioncount = 0;
                                <table style="width:500px; padding:0px 0px 0px 0px">
                                    <tr style="@SurveyFormatHeaderBG">
                                        <td>
                                            <table width="100%">
                                                <tr>
                                                    <td align="left">
                                                        @if (!string.IsNullOrEmpty(Model.ImageUrlLeft))
                                                        {
                                                            <img src="~/images/dforms/@Model.ImageUrlLeft"  style="" width="100px" height="70" />
                                                        }
                                                    </td>
                                                    <td align="right">
                                                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                                        {
                                                            <img src="~/images/dforms/@Model.ImageUrl" width="100px" height="70" />
                                                        }
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="sheetheading" style="@SurveyFormatHeaderBG">
                                            @Html.Raw(Model.Title)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="@SurveyFormatHeadDetailsBG">
                                            @Html.Raw(Model.Header)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>


                                            @foreach (var formsection in Model.Sections)
                                            {
                                                iQuestionCounter = 1;
                                                if (formsection.PKID == currentSection)
                                                {
                                                    borderWidth = "5px";
                                                }
                                                else
                                                {
                                                    borderWidth = "1px";
                                                }
                                                <table class="tbl" style="width:100%;  border:@borderWidth solid red; border-radius:10px 10px 10px 10px; margin-top:10px">

                                                    <tr class="sheetbg">
                                                        <td colspan="2" style="@SurveyFormatSectionBG">
                                                            <a href="/Admin/QuestionForms/ManageForm/@Model.PKID/@formsection.PKID">Edit Survey Question Series  / Add Question</a>
                                                            <h3> @formsection.Section</h3>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="2" class="sheetbg" style="@SurveyFormatSectionDetailsBG">
                                                            @Html.Raw(formsection.Detail)
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="2">
                                                            @foreach (var question in formsection.Questions)
                                                            {
                                                                if (question.PKID == currentQuestion)
                                                                {
                                                                    activeQuestionClass = "tbl active-question";
                                                                }
                                                                else
                                                                {
                                                                    activeQuestionClass = "tbl";
                                                                }
                                                                <table class="@activeQuestionClass" style="padding:5px 5px 5px 5px; width:100%; margin-top:10px;">
                                                                    <tr style="@QuestionBG">
                                                                        <td colspan="2">
                                                                           
                                                                                <a href="/Admin/QuestionForms/ManageForm/@Model.PKID/@question.SectionId/@question.PKID">Edit</a>
                                                                                Question @iQuestionCounter : @Html.Raw(question.Question)
                                                                            
                                                                        </td>
                                                                    </tr>
                                                                    @if (question.QuestionType == 1)
                                                                    {
                                                                        <tr style="@AnswerBG">
                                                                            <td colspan="2" align="left">
                                                                                @foreach (var answer in question.Answers)
                                                                                {
                                                                                    <div style="margin-left:20px">
                                                                                        <input id="@answer.PKID" class="custom-radio-group" type="radio" name="@question.PKID" />
                                                                                        <label for="@answer.PKID">@Html.Raw(answer.Answer) </label>
                                                                                    </div>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                    else if (question.QuestionType == 2)
                                                                    {
                                                                        <tr style="@AnswerBG">
                                                                            <td colspan="2" align="left">
                                                                                @foreach (var answer in question.Answers)
                                                                                {
                                                                                    <div style="margin-left:20px">
                                                                                    <label for="@answer.PKID" class="checkbox-container">
                                                                                        @Html.Raw(answer.Answer)
                                                                                        <input id="@answer.PKID" value="@answer.PKID" style="margin:4px" type="checkbox" name="@question.PKID" />
                                                                                        <span class="checkmark"></span>
                                                                                    </label>
                                                                                 
                                                                                        @* <input id="@answer.PKID" type="checkbox" name="@question.PKID" /><label > @Html.Raw(answer.Answer)</label> *@
                                                                                    </div>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                    else if (question.QuestionType == 3)
                                                                    {
                                                                        <tr style="@AnswerBG">
                                                                            <td colspan="2" align="left">
                                                                                <input type="range" min="1" max="10" value="5" class="form-range" />
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                    else if (question.QuestionType == 4)
                                                                    {
                                                                        <tr style="@AnswerBG">
                                                                            <td colspan="2" align="left">
                                                                                <input type="text" class="form-control" />
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                    else if (question.QuestionType == 5)
                                                                    {
                                                                        <tr style="@AnswerBG">
                                                                            <td colspan="2" align="left">
                                                                                <input type="file" name="file" id="file" class="form-control" />
                                                                            </td>
                                                                        </tr>


                                                                    }
                                                                </table>

                                                                iQuestionCounter = iQuestionCounter + 1;

                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr style="@SurveyFormatSectionFooterBG">
                                                        <td colspan="2" align="left">
                                                            @Html.Raw(formsection.Footer)
                                                        </td>
                                                    </tr>
                                                </table>
                                            }
                                        </td>
                                    </tr>
                                    <tr style="@SurveyFormatFooterBG">
                                        <td class="sheetheading">
                                            @Html.Raw(Model.Footer)
                                        </td>
                                    </tr>
                                     
                                </table>
                            }
                        </div>
                    </td>
                </tr>
            </table>

            <div style="display:none">
                <div id="previewImg">
                </div>
            </div>
        </div>
    </div>
}

<script>
    let url ="@ViewBag.Url";
     function SaveForm(typ)
     {

          $("#hidType").val(typ);
          var contentanswer= $('#CurrentSection_Detail').summernote('code');
          $('#CurrentSection_Detail').val(contentanswer);
          $('#frmFormSheetUpdate').submit();

     }



     function AddNewSection()
     {
           location.href = "//"+ url +  "/Admin/QuestionForms/ManageForm/"+ $("#PKID").val();
     }

      function AddNewCostItem()
     {
         let sectionId = $('#SectionId').val();
         if(sectionId >0)
         {
          location.href = "//"+ url +  "/Admin/QuestionForms/ManageForm/"+ $("#PKID").val() +"/" + sectionId;
         }
         else
         {
             alert("Please save sheet first");
         }
     }

     function DeleteAnswer(answerId)
     {

             if(confirm("Are you sure you want to delete this answer?")==true)
             {
                 $.ajax({
                 url: '/Admin/QuestionForms/DeleteAnswer', // Replace with your endpoint
                 type: 'POST',
                 data: { id: answerId  }, // Data sent to server
                 success: function(response) {
                      location.reload();
                 },
                 error: function(error) {
                     console.error(error);
                 }
               });
             }

     }

     function DeleteCostSheet(sheetId)
     {
         if(sheetId  >0)
         {
            if(confirm("Are you sure you want to delete this sheet?")==true)
             {
             $.ajax({
             url: '/Admin/Cost/DeleteCostSheet', // Replace with your endpoint
             type: 'POST',
             data: { id: sheetId  }, // Data sent to server
             success: function(response) {
                  location.reload();
             },
             error: function(error) {
                 console.error(error);
             }
           });
             }
        }
     }

     function SetUnitBoxDisability()
     {
         if($('#CostItem_UnitOperator').val() =="0")
         {

             $('#CostItem_UnitNo').attr("disabled");
         }
         else
         {
             $('#CostItem_UnitNo').removeAttr("disabled");
         }
     }

     function SetAnswerVisibility(objddl)
     {
         console.log(objddl);
         var typ=$(objddl).val();
         if(isNaN(typ))
         {
             typ = 0;
         }
         if(typ ==1 || typ==2)
         {
             $('.clOption').show();
             $('.clOptionRange').hide();
         }
         else if(typ ==3)
           {
              $('.clOption').hide();
             $('.clOptionRange').show();
           }
         else
         {
             $('.clOption').hide();
             $('.clOptionRange').hide();
         }
     }


</script>

