@model IEnumerable<JobPortal.Domain.Models.FormSection>
@{
    ViewData["Title"] = "Form Sections";
    Layout = "_LayoutAdmin";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Form Sections</h3>
    <a asp-action="ManageForm" asp-area="admin" asp-controller="forms" asp-route-id="@ViewBag.CategoryId" class="btn btn-warning">Manage Form</a>
    <a asp-action="CreateSection" asp-area="admin" asp-controller="forms" asp-route-id="@ViewBag.CategoryId" class="btn btn-success">Add Section</a>
</div>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Order</th>
            <th>Title</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.DisplayOrder</td>
                <td>@s.Title</td>
                <td>@(s.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Questions" asp-route-sectionId="@s.Id" class="btn btn-sm btn-outline-primary">Questions</a>
                    @if (s.Title.ToLower() == "profile" && s.FormTypeCategoryId == 1)
                    {
                        <a href="javascript: void(0);" class="btn btn-sm btn-outline-secondary disabled">Edit</a>
                         <a href="javascript: void(0);" class="btn btn-sm btn-outline-danger disabled">Delete</a>
                    }
                    else
                    {
                        <a asp-action="EditSection" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="DeleteSection" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Delete section?')">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                   
                </td>
            </tr>
        }
    </tbody>
</table>
