@model List<UserListForCompare>
@{

    ViewData["Title"] = "View Entries";
    Layout = "_LayoutAdmin";

}
<div class="container py-4">
    <h2>Data Entries -  </h2>


    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>User</th>

                <th style="width:300px;">Actions</th>
            </tr>

        </thead>
        <tbody>
            @foreach (var itm in Model)
            {
                <tr>
                    <td>@itm.UserName </td>

                    <td width="300">
                        <a asp-action="ViewData" asp-route-id="@ViewBag.FormId" asp-route-userId="@itm.UserId" class="btn btn-sm btn-secondary"> View Data</a>
                        <a asp-area="Admin" asp-controller="AdminFormSubmissions" asp-action="ViewSubmission" asp-route-userId="@itm.UserId" asp-route-formIds="@ViewBag.FormId" class="btn btn-sm btn-primary"> View Submission</a>
                    </td>
                </tr>


            }



        </tbody>
    </table>
</div>
@section Scripts
{
  
}