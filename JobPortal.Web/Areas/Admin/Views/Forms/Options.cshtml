@model JobPortal.Domain.Models.FormQuestion
@{
    ViewData["Title"] = "Options - " + Model.QuestionText;
    Layout = "_LayoutAdmin";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@Html.Raw(ViewData["Title"])</h3>
    <a asp-action="CreateOption" asp-route-questionId="@Model.Id" class="btn btn-success">Add Option</a>
</div>
<table class="table table-bordered">
    <thead>
        <tr><th>Order</th><th>Text</th><th>Active</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var o in Model.Options.OrderBy(x => x.DisplayOrder))
        {
            <tr>
                <td>@o.DisplayOrder</td>
                <td>@Html.Raw(o.OptionText)</td>
                <td>@(o.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-action="EditOption" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="DeleteOption" asp-route-id="@o.Id" method="post" class="d-inline" onsubmit="return confirm('Delete option?')">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Questions" asp-route-sectionId="@Model.SectionId" class="btn btn-outline-secondary">Back</a>
