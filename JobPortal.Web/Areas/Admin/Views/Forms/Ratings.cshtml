@model JobPortal.Web.ViewModels.FormVm
@using JobPortal.Domain.Models;

@{

    ViewData["Title"] = "Survey";
    Layout = "_LayoutJobSeeker";

    int i = 0;
}
 

<div class="card p-3 mb-4">
    <h5>⭐ My Rating</h5>

  @*   <div class="mb-3">
        <strong>Overall Average:</strong>
        <span class="badge bg-primary">@Model.AvgRating.ToString("0.0") / 10</span>
    </div> *@

    @if (Model.NewRatings != null && Model.NewRatings.Any())
    {
        i = 0;
        <div>
            <strong>Question List (Detailed Ratings):</strong>
        </div>
           <div class="outer">
                            <div class="inner">
                <table class="fixedtable">
            <thead>

                <tr>
                    @foreach (var col in Model.NewRatings.First().Keys)
                    {
                                if (i == 0)
                                {
                                    <th class=fix>@col</th>
                                }
                                else
                                {
                                    <th>@col</th>
                                }
                       
                    }
                </tr>
            </thead>
                    @{
                        i = 0;
                    }
            <tbody>
                @foreach (var row in Model.NewRatings)
                {
                    <tr>
                        @foreach (var col in row.Keys)
                        {
                                    if (i == 0)
                                    {
                                        <td class=fix>@row[col]</td>
                                    }
                                    else
                                    {
                                        <td>@row[col]</td>
                                    }
                            
                        }
                    </tr>
                }
            </tbody>
        </table>
        </div></div>
    }
    else
    {
        <p>No data found.</p>
    }


