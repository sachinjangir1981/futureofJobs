@model FormTypeCategory
@{

    ViewData["Title"] = "View Category";
    Layout = "_LayoutAdmin";
}
<div class="container py-4">
    <h2>Details</h2>
    <dl class="row">
        <dt class="col-sm-3">Form Category</dt>
        <dd class="col-sm-9">@Model.FormCategory</dd>
        <dt class="col-sm-3">Display Order</dt>
        <dd class="col-sm-9">@Model.DisplayOrder</dd>
        <dt class="col-sm-3">Is ReadOnly</dt>
        <dd class="col-sm-9">@Model.IsReadOnly</dd>
        <dt class="col-sm-3">Is Active</dt>
        <dd class="col-sm-9">@Model.IsActive</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Edit</a>
    <a asp-action="Index"   class="btn btn-secondary">⬅ Back</a>
</div>
