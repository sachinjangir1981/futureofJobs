@model JobPortal.Domain.Models.FormSection
@{
    ViewData["Title"] = (Model?.Id > 0 ? "Edit Section" : "Create Section");
    Layout = "_LayoutAdmin";
}
<h3>@ViewData["Title"]</h3>
<div>
    @Html.ValidationSummary()
    <div asp-validation-summary="All" class="text-danger"></div>
</div>
<form method="post" class="card p-3">
    <div class="mb-3">
        <label class="form-label">Title</label>
        @Html.EditorFor(m => m.Title, new { htmlAttributes = new { @class = "form-control" } })
       
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Display Order</label>
        @Html.EditorFor(m => m.DisplayOrder, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
        
    </div>
    <div class="form-check mb-3">
        @Html.EditorFor(m => m.IsActive, new { htmlAttributes = new { @class = "form-check-input"  } })
        <input type="hidden" asp-for="FormTypeCategoryId" />
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>
    <button class="btn btn-success">Save</button>
    <a asp-action="Sections" asp-route-id="@Model.FormTypeCategoryId" class="btn btn-outline-secondary">Back</a>
</form>
