@model FormTypeCategory
@{
    ViewData["Title"] = (Model?.Id > 0 ? "Edit Category" : "Create Category");
    Layout = "_LayoutAdmin";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">
<div class="container py-4">
    <h2>@ViewData["Title"] Form Type Category</h2>
    <form asp-action="CreateCategory" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="FormCategory" class="form-label"></label>
            <input asp-for="FormCategory" class="form-control" />
            <span asp-validation-for="FormCategory" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Details" class="form-label"></label>
            @Html.TextAreaFor(m => m.Details, new { @class = "form-control summernote", rows = 4 })

        </div>
        <div class="mb-3">
            <label asp-for="FooterNote" class="form-label"></label>
            @Html.TextAreaFor(m => m.FooterNote, new { @class = "form-control summernote", rows = 4 })
        </div>
        <div class="mb-3">
            <label class="form-label">ImageUrl</label>
            <input type="file" name="fImageUrl" id="fImageUrl" />
            <input type="hidden" asp-for="ImageUrl" />
            <img src="/images/forms/@Model.ImageUrl" alt="Current Image" style="max-height:100px; display:block; margin-top:10px;" />
        </div>
        <div class="mb-3">
            <label class="form-label">Bg Image Url</label>
            <input type="file" name="fBgImageUrl" id="fBgImageUrl" />
            <input type="hidden" asp-for="BgImageUrl" />
            <img src="/images/forms/@Model.BgImageUrl" alt="Current Image" style="max-height:100px; display:block; margin-top:10px;" />
        </div>


        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsPublic" class="form-check-input" />
            <label asp-for="IsPublic" class="form-check-label"></label>
        </div>

        <div class="form-check mb-3">
            <select asp-for="ForRole" class="form-check-select">
                <option value="1">JobSeeker</option>
                <option value="2">Employer</option>
                <option value="3">Academics</option>
                <option value="4">Normal</option>
            </select>
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary">💾 Save</button>
        <a asp-action="Index" class="btn btn-secondary">⬅ Back</a>
    </form>
</div>
@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="/js/summernote-bs4.min.js"></script>
    <script src="/js/summernote-local.js"></script>
}