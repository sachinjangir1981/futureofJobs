@model JobPortal.Domain.Models.FormSection
@{
    ViewData["Title"] = (Model?.Id > 0 ? "Edit Section" : "Create Section");
    Layout =  ViewBag.Layout == 1 ? "_LayoutAdmin" : "_LayoutNone";
}
<h3>@ViewData["Title"]</h3>
<form method="post" asp-action="EditSection" asp-asp-controller="Forms" class="card p-3">
    <div class="mb-3">
        <label class="form-label">Title</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Display Order</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" />
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>
    <input type="hidden" id="layout" name="layout" value="@ViewBag.Layout" />
    <input type="hidden" asp-for="FormTypeCategoryId" />
    @if (ViewBag.Layout == 1)
    {

        <button class="btn btn-success">Save</button>
        <a asp-action="Sections" asp-route-id="@Model.FormTypeCategoryId" class="btn btn-outline-secondary">Back</a>
    }
    else
    {
        <button type="button" onclick="Save()" class="btn btn-success">Save</button>
    }
</form>
