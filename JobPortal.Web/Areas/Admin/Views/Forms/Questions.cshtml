@model JobPortal.Domain.Models.FormSection
@{
    ViewData["Title"] = "Questions - " + Model.Title;
    Layout = "_LayoutAdmin";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <a asp-action="CreateQuestion" asp-route-sectionId="@Model.Id" class="btn btn-success">Add Question</a>
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Order</th>
            <th>Question</th>
            <th>Type</th>
            <th>Required</th>
            <th>Options</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var q in Model.Questions.OrderBy(x => x.DisplayOrder))
        {
            <tr>
                <td>@q.DisplayOrder</td>
                <td>@Html.Raw(q.QuestionText)</td>
                <td>@q.QuestionType</td>
                <td>@(q.IsRequired ? "Yes" : "No")</td>
                <td>
                    @if (q.QuestionType == JobPortal.Domain.Models.QuestionType.SingleChoice || q.QuestionType == JobPortal.Domain.Models.QuestionType.MultipleChoice)
                    {
                        <a asp-action="Options" asp-route-questionId="@q.Id" class="btn btn-sm btn-outline-primary">Manage</a>
                    }
                </td>
                <td>
                    <a asp-action="EditQuestion" asp-route-id="@q.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="DeleteQuestion" asp-route-id="@q.Id" method="post" class="d-inline" onsubmit="return confirm('Delete question?')">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Sections" asp-route-id="@Model.FormTypeCategoryId" class="btn btn-outline-secondary">Back</a>
