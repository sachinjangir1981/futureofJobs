@model JobPortal.Domain.Models.FormQuestion
@using JobPortal.Domain.Models
@{
    ViewData["Title"] = (Model?.Id > 0 ? "Edit Question" : "Create Question");
    Layout = ViewBag.Layout == 1 ? "_LayoutAdmin" : "_LayoutNone";
}
<h3>@ViewData["Title"]</h3>
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">

<form method="post" asp-action="CreateQuestion" asp-asp-controller="Forms" class="card p-3">
    <input type="hidden" asp-for="SectionId" />
    <div class="mb-3">
        <label class="form-label">Question Text</label>
        
        <textarea asp-for="QuestionText" class="form-control summernote" rows="4"></textarea>
        <span asp-validation-for="QuestionText" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Explanation</label>
        <textarea asp-for="Explanation" class="form-control summernote" rows="4"></textarea>
        <span asp-validation-for="Explanation" class="text-danger"></span>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Type</label>
            <select asp-for="QuestionType" class="form-select" asp-items="Html.GetEnumSelectList<QuestionType>()"></select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Display Order</label>
            <input asp-for="DisplayOrder" type="number" class="form-control" />
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="IsRequired" class="form-check-input" />
                <label asp-for="IsRequired" class="form-check-label">Required</label>
            </div>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="IsRating" class="form-check-input" />
                <label asp-for="IsRating" class="form-check-label">Rating Enabled</label>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="Marks" type="number" step="1" min="1" max="100" value="10" class="form-control " />
                <label asp-for="Marks" class="form-check-label">Marks</label>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="Weightage" type="number" step=".1" min=".1" max="5" value="1" class="form-control " />
                <label asp-for="Weightage"   class="form-check-label">Weightage</label>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="IsCompare" class="form-check-input" />
                <label asp-for="IsCompare" class="form-check-label">Compare Enabled</label>
            </div>
        </div>
           <div class="col-md-3 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="IsFilter" class="form-check-input" />
                <label asp-for="IsFilter" class="form-check-label">Filter Enabled</label>
            </div>
        </div>

    </div>
    <input type="hidden" id="layout" name="layout" value="@ViewBag.Layout" />
    @if (ViewBag.Layout == 1)
    {
    <button class="btn btn-success mt-3">Save</button>
    <a asp-action="Questions" asp-route-sectionId="@Model.SectionId" class="btn btn-outline-secondary mt-3">Back</a>
    }
    else
    {
        <button type="button" onclick="Save()" class="btn btn-success">Save</button>
    }
</form>



@section Scripts
    {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="/js/summernote-bs4.min.js"></script>
    <script src="/js/summernote-local.js"></script>
    <script>
        const slider = document.getElementById('Weightage');
        const output = document.getElementById('spnWeightage');

        // Display the initial value
        output.innerHTML = slider.value;

        // Update the value as the slider is dragged
        slider.oninput = function() {
          output.innerHTML = this.value;
        };
    </script>
}