@using JobPortal.Web.Models;
@model CuratedJob
@{
    Layout = "_LayoutAdmin";

}
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">

@using (Html.BeginForm("ManageJobs", "CuratedJobs", FormMethod.Post, new { id = "frmFormpaper", @enctype = "multipart/form-data" }))
{

    <div class="form-horizontal" style="padding:15px">
        <h4> Add/Edit Jobs</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @if (!string.IsNullOrEmpty(ViewBag.msg))
        {
            <div class="alert-success">
                @ViewBag.msg
            </div>
        }
        <div class="row">
            <div class="col-12">
                @Html.HiddenFor(model => model.PKID)
                Job Title
                @Html.EditorFor(model => model.JobTitle, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.JobTitle, "", new { @class = "text-danger" })

            </div>

            <div class="col-12">

                Company Name
                @Html.EditorFor(model => model.CompanyName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })

            </div>

            <div class="col-12">

                Domain / Tag
                @Html.EditorFor(model => model.DomainTag, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DomainTag, "", new { @class = "text-danger" })

            </div>

            <div class="col-12">

                Source / Link
                @Html.EditorFor(model => model.SourceLink, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.SourceLink, "", new { @class = "text-danger" })

            </div>

            <div class="col-12">

                Posted Date : @Model.PostedDate.ToString("dd-MM-yyyy")
                <input asp-for="PostedDate2" type="date" class="form-control" />
               @*  @Html.EditorFor(model => model.PostedDate2, new { htmlAttributes = new { @class = "form-control", @type="Date", @format="dd-MM- yyyy" } })
                @Html.ValidationMessageFor(model => model.PostedDate2, "", new { @class = "text-danger" }) *@

            </div>


           

            <div class="col-6">
                @Html.CheckBoxFor(model => model.IsActive)
                Is Active

            </div>

             



        </div>






        <div class="row" style="padding-top:30px">
            <div class="col-md-12">

                <input id="btnSubmitContent" type="submit" value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

