@using JobPortal.Web.Models;
@model List<OneMinuteItem>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int i = 0;
}

<div style="float:right">
    <a href="/admin/OneMinute/Create" class="btn btn-primary">Create</a>

</div>
<table>
    <tr>
        <td>&nbsp;</td>
    </tr>
</table>
<table id="myTable" class="table">
    <thead>
        <tr>
            <th width="40">SNO</th>
            <th>One Minute</th>

            <th>Card</th>

            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var itm in Model)
        {
            i++;
            <tr>
                <td width="40">@i </td>
                <td>@Html.Raw(itm.Title)</td>

                <td><a href="/visitor/OneMinute/@itm.PKID" class="btn">View Card</a> </td>
                <td><a href="/admin/OneMinute/Edit/@itm.PKID" class="btn">Edit</a> </td>
                <td><a href="javascript:void(0);" onclick="javascript:deleteCustomer(@itm.PKID);" class="btn btn-danger">Delete</a> </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        $('.navbar-brand').removeClass("active");
        $('#aiom').addClass("active");
    });
    function deleteCustomer(id) {
        if (confirm("Are you sure you want to delete this one minute article?")) {
            $.ajax({
                type: "POST",
                url: "/admin/OneMinute/Delete",
                data: "id=" + id,
                dataType: "json",
                success: function (data) {
                    window.location.reload();
                },
                error: function () {
                    console.log("error");
                }
            });
        }
    }

    function syncCustomer(id) {

        $.ajax({
            type: "POST",
            url: "/admin/OneMinute/SyncPost",
            data: "id=" + id,
            dataType: "json",
            success: function (data) {
                window.location.reload();
            },
            error: function () {
                console.log("error");
            }
        });
    }
</script>
