@model JobPortal.Web.Models.OneMinuteItem

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Create</h2>
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.18/summernote-bs4.min.css" rel="stylesheet">
@using (Html.BeginForm("Create", "OneMinute", FormMethod.Post, new { @id = "frmCreate", @enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <h4>One Minute</h4>
            <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.PKID)


            <div class="form-group">
                <div class="col-md-2"><b>Title </b></div>
                <div class="col-md-10">

                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control"  } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-2">
                    <b>What's the Point</b>
                </div>
                <div class="col-md-10">
                @Html.TextAreaFor(model => model.NewsSubject,  new { @class = "form-control summernote", rows = 4, cols = 50   })
                @Html.ValidationMessageFor(model => model.NewsSubject, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-2">
                    <b>Deep Diving !</b>
                </div>
                <div class="col-md-10">
                @Html.TextAreaFor(model => model.Discussion, new  { @class = "form-control summernote", rows = 4, cols = 50   })
                @Html.ValidationMessageFor(model => model.Discussion, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-2">
                    <b>Think About It</b>
                </div>
                <div class="col-md-10">
                @Html.TextAreaFor(model => model.FeedBackLink, new   { @class = "form-control summernote", rows = 4, cols = 50 } )
                @Html.ValidationMessageFor(model => model.FeedBackLink, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-2">
                    <b>One Minute! </b>
                </div>
                <div class="col-md-10">
                @Html.TextAreaFor(model => model.MediaRef, new  { @class = "form-control summernote", rows = 4, cols = 50 }  )
                @Html.ValidationMessageFor(model => model.MediaRef, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
            @Html.LabelFor(model => model.DisplayOrder, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                @Html.EditorFor(model => model.DisplayOrder, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                @Html.ValidationMessageFor(model => model.MediaRef, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
            @Html.LabelFor(model => model.CoverPhoto, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">

                    <input type="file" name="fCoverPhoto" id="fCoverPhoto" />
                @Html.HiddenFor(model => model.CoverPhoto)


                </div>
            </div>
            <div class="form-group">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">

                @Html.CheckBoxFor(model => model.IsActive)

                </div>
            </div>





            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </div>
        </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="~/js/summernote-bs4.min.js"></script>

         <script src="~/js/summernote-local.js"></script>
 }