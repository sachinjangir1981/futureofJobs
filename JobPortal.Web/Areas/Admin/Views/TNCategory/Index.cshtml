@using JobPortal.Models;
@model List<WpPostCategory>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int i = 1;
}
<div style="float:right">
    <a href="/admin/TNCategory/Create" class="btn btn-primary">Create Category</a>

</div>

<table id="myTable" class="table">

    <tr>
        <th width="50px">SNO</th>
        <th>Category</th>
       
        <th width="100px">Edit</th>
        <th width="100px">Delete</th>
    </tr>

    @foreach (var itm in Model)
    {
        <tr>
            <td width="50px">@i</td>
            <td>@itm.CatName</td>
           
            <td width="100px"><a href="/admin/TNCategory/Edit/@itm.PKID" class="btn"> Edit</a> </td>
            <td width="100px"><button onclick="DeleteCategory(@itm.PKID)">Delete</button> </td>
        </tr>
    }

</table>
<script>

    $(document).ready(function () {
        $('.navbar-brand').removeClass("active");
        $('#atnews').addClass("active");
    });



    function DeleteCategory(id) {
        if (confirm('Are you sure to delete this category?')) {
            $.ajax({
                type: "POST",
                url: "/admin/tncategory/Delete",
                data: "id=" + id,
                dataType: "json",
                success: function (data) {
                    window.location.reload();
                },
                error: function () {
                    console.log("error");
                }
            });
        }
    }

</script>
