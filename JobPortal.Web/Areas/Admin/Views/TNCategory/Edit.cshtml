@using JobPortal.Models;
@model WpPostCategory
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@using (Html.BeginForm("Edit", "TNCategory", FormMethod.Post, new { id = "frmForm", @enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4> Add/Edit Category</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row">
            <div class="col-md-12">
                @Html.HiddenFor(model => model.PKID)
                @Html.HiddenFor(model => model.ParentCatId)
                Category

                @Html.EditorFor(model => model.CatName, new { htmlAttributes = new { @class = "form-control", @type = "numeric" } })
                @Html.ValidationMessageFor(model => model.CatName, "", new { @class = "text-danger" })




            </div>

        </div>





        <div class="row" style="padding-top:30px">

            <div class="col-md-4">

                Image
                <input type="file" name="fImageUrl" id="fImageUrl" />

                @Html.HiddenFor(m => m.ImageUrl)
                <img src="/images/snippet/@Model.ImageUrl" width="100" />
            </div>
            <div class="col-md-4">

                BG Image
                <input type="file" name="fBgImageUrl" id="fBgImageUrl" />
                <img src="/images/snippet/@Model.BgImageUrl" width="100" />
                @Html.HiddenFor(m => m.BgImageUrl)
            </div>
        </div>
        <div class="row" style="padding-top:30px">

            <div class="col-md-6">
            </div>
        </div>
        <div class="row" style="padding-top:30px">
            <div class="col-md-12">

                <input id="btnSubmit" type="submit" value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

