@model JobPortal.Web.ViewModels.FormVm
@using JobPortal.Domain.Models;

@{
    ViewData["Title"] = "My Profile";
    Layout = "_LayoutAcademics";
}

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success">@TempData["Saved"]</div>
}

<form asp-action="Save" method="post" enctype="multipart/form-data">
@foreach (var section in Model.Sections)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">@*  @section.Title *@ </h5>
        </div>
        <div class="card-body">
            @foreach (var q in section.Questions.OrderBy(x => x.DisplayOrder))
            {
                var existingText = Model.AnswersText.ContainsKey(q.Id) ? Model.AnswersText[q.Id] : null;
                var existingFile = Model.AnswersFile.ContainsKey(q.Id) ? Model.AnswersFile[q.Id] : null;

                <div class="mb-3">
                    <label class="form-label">@q.QuestionText @if(q.IsRequired){<span class="text-danger">*</span>}</label>

                    @switch (q.QuestionType)
                    {
                        case QuestionType.Text:
                            {
                                <input name="Answers[@q.Id]" class="form-control" value="@existingText" @(q.IsRequired ? "required" : "") />
                                break;
                            }
                        case QuestionType.SingleChoice:
                            {
                                foreach (var opt in q.Options.Where(o => o.IsActive).OrderBy(o => o.DisplayOrder))
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Answers[@q.Id]" value="@opt.OptionText" @(existingText == opt.OptionText ? "checked" : "") @(q.IsRequired ? "required" : "") />
                                        <label class="form-check-label">@opt.OptionText</label>
                                    </div>
                                }
                                break;
                            }
                        case QuestionType.MultipleChoice:
                            {
                                var selected = (existingText ?? "").Split('|', System.StringSplitOptions.RemoveEmptyEntries).ToHashSet(StringComparer.OrdinalIgnoreCase);
                                foreach (var opt in q.Options.Where(o => o.IsActive).OrderBy(o => o.DisplayOrder))
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Answers[@q.Id]" value="@opt.OptionText" @(selected.Contains(opt.OptionText) ? "checked" : "") />
                                        <label class="form-check-label">@opt.OptionText</label>
                                    </div>
                                }
                                if (q.IsRequired)
                                {
                                    <small class="text-muted">Select at least one.</small>
                                }
                                break;
                            }
                        case QuestionType.FileUpload:
                            {
                                if (!string.IsNullOrWhiteSpace(existingFile))
                                {
                                    <div class="mb-2">
                                        <a href="@existingFile" target="_blank" class="btn btn-sm btn-outline-secondary">View current file</a>
                                    </div>
                                }
                                <input type="file" name="Files[@q.Id]" class="form-control" @(q.IsRequired && string.IsNullOrWhiteSpace(existingFile) ? "required" : "") />
                                break;
                            }
                    }
                </div>
            }
        </div>
    </div>
}
    <button class="btn btn-success btn-lg">Save Profile</button>
</form>
