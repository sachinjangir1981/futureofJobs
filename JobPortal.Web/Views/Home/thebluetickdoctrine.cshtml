@using JobPortal.Web.Models;
@model List<LibraryModel>
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
 
@section HeaderImage
{
    <div class="headerImage2">
        <img src="~/images/greenjob_newhome.jpg" />
    </div>
}
<div class="">
    <div class="fowtop">
        
    </div>
    <div class="hometext fowbottom">
        <ul class="ulBreadcrumb" style="margin-top:2px">
            <li><a href="/">Home <span class="fa fa-angle-right"></span></a></li>
            <li><a href="/home/futureofwork">Future Of Work </a></li>
        </ul>
        <p class="paraHeader" style="margin-top:3px; padding:8px 8px 8px 8px"><b>The Blue Tick Doctrine for Future of Work </b> </p>
        <p class="paraCommon">
            <i>From Ghosting to Mutual Accountability in the Future of Work - Conceptualised at GreenJobs Digital</i>
        </p>
         
        <p class="paraCommon">
            <table class="tbl" width="100%">
                @foreach (var itm in Model)
                {

                     <tr>
                    <td>
                        @if (itm.IsCategory == 1)
                        {

                            <a href="/visitor/librarylist/@itm.PKID">@itm.DisplayOrder. @Html.Raw(itm.Title)  <span class="fa fa-angle-right"></span><br /><span style="display:block; padding-top:7px;"><img src="~/images/click_here_3.png" width="45px" /></span></a>
                        }
                        else
                        {
                            <a href="/visitor/library/@itm.PKID">@itm.DisplayOrder. @Html.Raw(itm.Title) <br /><span style="display:block; padding-top:7px;"><img src="~/images/click_here_3.png" width="45px" /></span> </a>
                        }
                    </td>
                </tr>
                }
            </table>
        </p>
    </div>
</div>
