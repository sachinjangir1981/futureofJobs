@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section HeaderImage
{
    <div class="headerImage2">
        <img src="~/images/talenmt-scouting.png" />
    </div>
}
<div class="hometext">
    <p class="paraCommon" style="text-align:center">
        <img src="/images/talentscoutig5.png" width="50%" />
    </p>
    <div class="">
        <p class="paraCommon paraHeader">
            <b>Interviews; Speak human, not HR</b> 
            <span style="font:20px"><b>Talent leaves interviews not because of salary… but because of tone.</b></span>
        </p>

        <p class="paraCommon">A scripted interview feels like punishment.<b>Where Most Employers Lose the Game.</b>  A sincere conversation feels like opportunity. </p>
        <p class="paraCommon"><i>Gen Z wants honesty.</i></p>
        <p class="paraCommon"><i>Millennials want purpose.</i></p>
        <p class="paraCommon"><i>Mid-career professionals want dignity.</i></p>
        <p class="paraCommon"><i>Silver talent wants respect. </i></p>
        <p class="paraCommon">When interviews sound human, not mechanical, great candidates stay in the room. Good interviews don’t impress, <b>they connect.</b></p>
        <p class="paraCommon">Modern talent isn’t evaluating salary; they’re evaluating <i>humanness.</i> </p>
        <p class="paraCommon">Did you listen?</p>
        <p class="paraCommon">Did you explain the role honestly?</p>
        <p class="paraCommon">Did you show dignity?</p>
        <p class="paraCommon">Did you speak like a human being or like an HR chatbot?</p>
        <p class="paraCommon"><b>A playful, open, transparent interview makes candidates lean in while a stiff, scripted one makes them run.</b> </p>
        <p class="paraCommon">
            Click Here to Participate in Talent Interviews Poll
            <a href="/visitor/poll/52" class="homeImage"><img src="~/images/audience-poll.png" width="70px" /></a>
        </p>
        <p class="paraCommon"> </p>
    </div>
</div>
