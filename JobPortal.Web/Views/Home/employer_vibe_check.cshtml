@using JobPortal.Web.Models;

@model List<LibraryModel>
@{
    ViewBag.Title = "Library";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string serialNo = "";
    int padding = 0;
    string paddingstr = "";
}
<link href="~/css/timepass.css" rel="stylesheet" />

@section HeaderImage
{
    <div class="headerImage2">
        <img src="~/images/employer.jpeg" />
    </div>
}
<div class="bgemployervibechecktop">
</div>
<div class="hometext bgemployervibecheck">
    <ul class="ulBreadcrumb">
        <li><a href="/">Home <span class="fa fa-angle-right"></span></a></li>
        <li><a href="/home/employer">Modern Pragmatic Employers; <span class="fa fa-angle-right"></span></a></li>
    </ul>
@if (Model != null)
{
    <div class="rounded-3"  >
            <p class="paraCommon" style="text-align:center">
                <img src="/images/employer6.png" width="50%" />
            </p>
        <p class="paraCommon paraHeader"> <b>Employer Vibe Checks</b> </p>
        <p class="paraCommon">
            Before frameworks come feelings. Before strategies come situations.
        </p>
        <p class="paraCommon">Employer Vibe Checks are quick, situational reflections on modern workplaces written from lived experience, not policy decks. </p>
        <p class="paraCommon">They spotlight moments that make leaders laugh uncomfortably and say, <i>“Yeh toh humare yahan bhi hota hai.”</i></p>
        <p class="paraCommon"><b>Short reads. Sharp mirrors. Zero sermons. Plenty of recognition.</b></p>
        <p class="paraCommon">
            <table class="tbl" width="100%">
                

                    @foreach (var itm in Model)
                    {

                        <tr>
                            <td>
                                <a href="/visitor/library/@itm.PKID" style="text-decoration:none;color:#000">@serialNo@itm.DisplayOrder. @Html.Raw(itm.Title) <br /><span style="display:block; padding-top:7px;"><img src="~/images/click_here_3.png" width="45px" /></span></a>
                            </td>
                        </tr>
                    }
               
            </table>



        </p>

    </div>
}
</div>
