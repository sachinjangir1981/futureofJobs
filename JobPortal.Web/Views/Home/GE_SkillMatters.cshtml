    Layout = "/Views/Shared/_Layout.cshtml";
}

@section HeaderImage
{
    <div class="headerImage2">
        <img src="~/images/skills.png" />
    </div>
}
<div class="bggreeneducationtopbg">
</div>
<div class="hometext bggreeneducationbg" style="min-height:95vh">
    <ul class="ulBreadcrumb" style="padding-top:10px;">
        <li><a href="/">Home <span class="fa fa-angle-right"></span></a></li>
        <li><a href="/home/Green_Education_Skilling">Green Education & Skills <span class="fa fa-angle-right"></span></a></li>
    </ul>
    <p class="paraCommon" style="text-align:center">
        <img src="/images/education-9.png" width="50%" />
    </p>

    <p class="paraCommon paraHeader">
        <b>Skills Matter More Than Syllabus</b>
    </p>

    <p class="paraCommon">
        They care about things like:
    </p>
