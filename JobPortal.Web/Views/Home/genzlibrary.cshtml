@using JobPortal.Web.Models;

@model List<LibraryModel>
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    string serialNo = "";
    int padding = 0;
    string paddingstr = "";
}
<link href="~/css/timepass.css" rel="stylesheet" />

@section HeaderImage
{
    <div class="headerImage2">
        <img src="~/images/student.jpeg" />
    </div>
}
<div class="genzlibrarytopbg">
</div>
<div class="hometext bgGenzlibrary">
    <ul class="ulBreadcrumb">
        <li><a href="/">Home <span class="fa fa-angle-right"></span></a></li>
        <li><a href="/home/hellogenz">Welcome to Your Inner Operating System <span class="fa fa-angle-right"></span></a></li>
    </ul>
    <p class="paraCommon">

        @if (Model != null)
        {
            <table class="tbl" width="100%">


                @foreach (var itm in Model)
                {

                    <tr>
                        <td>
                            <a href="/visitor/library/@itm.PKID" style="text-decoration:none;color:#000">@serialNo@itm.DisplayOrder. @Html.Raw(itm.Title) <br /><span style="display:block; padding-top:7px;"><img src="~/images/click_here_3.png" width="45px" /></span></a>
                        </td>
                    </tr>
                }

            </table>
        }

     

    </p>
    <p class="paraCommon"></p>
</div>