@{
    Layout = null;
}
@{
    var currentPath = Context.Request.Path.Value?.ToLower();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JobPortal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <style>
        body {
            display: flex;
            min-height: 100vh;
        }

        /*   .sidebar {
                    width: 250px;
                     height: 100vh;
                    background: #198754;
                    color: white;
                    flex-shrink: 0;
                } */

        .sidebar a {
            color: white;
            text-decoration: none;
        }

            .sidebar a:hover {
                background-color: #d4edda; /* light green */
                color: #155724; /* dark green text */
            }

        .sidebar .nav-link:hover {
            background-color: #d4edda; /* light green */
            color: #155724; /* dark green text */
        }

        .sidebar .nav-link.active {
            /* background-color: rgba(255,255,255,0.2); */
        }

        .content {
            flex-grow: 1;
            background: #f8f9fa;
        }

        .navbar-toggler {
            border: none !important;
        }

            .navbar-toggler:focus {
                box-shadow: none !important;
            }

        .sidebar .nav-link {
            color: #fff;
            padding: 10px 15px;
            border-radius: 8px;
            transition: all 0.2s ease-in-out;
        }

            .sidebar .nav-link:hover {
                background-color: #d4edda; /* light green */
                color: #155724; /* dark green text */
            }

            .sidebar .nav-link.active {
                background-color: #28a745; /* bootstrap green */
                color: #fff !important;
                font-weight: 600;
            }

        .sidebar .collapse .nav-link {
            font-size: 0.9rem;
            padding-left: 25px;
        }

        .disabled {
            pointer-events: none;
            cursor: default;
            opacity: 0.6;
        }

        /* width for desktop sidebar */
        .sidebar {
            width: 250px;
            background: #198754;
            color: white;
            flex-shrink: 0;
            min-height: 100vh;
            position: sticky;
            top: 56px; /* if you have a fixed header of 56px height */
            overflow-y: auto;
        }

        /* ensure main content aligns when sidebar present */
        @@media (min-width: 768px) {
            #mainContent {
                padding-left: 1.5rem;
            }
        }

        /* ensure offcanvas body uses full height scroll */
        .offcanvas-body .nav {
            height: calc(100vh - 56px);
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="d-none d-md-flex flex-column sidebar   text-white p-3" id="desktopSidebar" role="navigation">
        <h4 class="">Job Portal</h4>
        <hr />
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-link ">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>



            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#formsMenu" role="button" aria-expanded="false" aria-controls="formsMenu">
                    <span><i class="bi bi-briefcase"></i> Forms</span>
                    <i class="bi bi-caret-down-fill small"></i>
                </a>
                <div class="collapse ms-3" id="formsMenu">
                    <ul class="nav flex-column">
                        <li><a class="nav-link" href="/Admin/Forms/Sections/1">Students</a></li>
                        <li><a class="nav-link" href="/Admin/Forms/Sections/2">Academic Institutes</a></li>
                        <li><a class="nav-link" href="/Admin/Forms/Sections/3">Consultants</a></li>
                        <li><a class="nav-link" href="/Admin/Forms/Sections/4">Professionals</a></li>
                        <li><a class="nav-link" href="/Admin/Forms/Sections/5">Employers</a></li>
                        <li><a class="nav-link" href="/Admin/Forms/Categories">Others</a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#masterMenu" role="button" aria-expanded="false" aria-controls="masterMenu">
                    <span><i class="bi bi-briefcase"></i> Masters</span>
                    <i class="bi bi-caret-down-fill small"></i>
                </a>
                <div class="collapse ms-3" id="masterMenu">
                    <ul class="nav flex-column">
                        <li><a class="nav-link" href="/Admin/SkillCategory/">Skill Categories</a></li>
                        <li><a class="nav-link" href="/Admin/Skill/">Skills</a></li>

                    </ul>
                </div>
            </li>

            <!-- Applications with Submenu -->
           

            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#pollMenu" role="button" aria-expanded="false" aria-controls="pollMenu">
                    <span><i class="bi bi-person-badge"></i> Polls</span>
                    <i class="bi bi-caret-down-fill small"></i>
                </a>
                <div class="collapse ms-3" id="pollMenu">
                    <ul class="nav flex-column">
                        <li><a class="nav-link" href="/admin/QuestionCategory/index">Category</a></li>
                        <li><a class="nav-link" href="/admin/Polls/Index">Polls</a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#libraryMenu" role="button" aria-expanded="false" aria-controls="libraryMenu">
                    <span><i class="bi bi-person-badge"></i> CMS</span>
                    <i class="bi bi-caret-down-fill small"></i>
                </a>
                <div class="collapse ms-3" id="libraryMenu">
                    <ul class="nav flex-column">
                        <li><a class="nav-link" href="/admin/Library/Categories">Library Category</a></li>
                        <li><a class="nav-link" href="/admin/Library/Index">Library</a></li>
                        <li><a class="nav-link" href="/admin/QuestionForms/Index">Survey</a></li>
                        <li><a class="nav-link" href="/admin/Timepass/Index">Timepass</a></li>
                        <li><a class="nav-link" href="/admin/OneMinute/Index">One Minute</a></li>
                        <li><a class="nav-link" href="/admin/MyPoint/Index">My Point</a></li>
                        <li><a class="nav-link" href="/admin/TNCategory/Index">Trending News Category</a></li>
                        <li><a class="nav-link" href="/admin/TrendingNews/Index">Trending News</a></li>
                        <li><a class="nav-link" href="/admin/TPCategory/Index">Timepass Categories</a></li>
                        <li><a class="nav-link" href="/admin/Timepass5Line/Index">Timepass 5 Line</a></li>
                    </ul>
                </div>
            </li>
            <li class="nav-item"><a asp-controller="CuratedJobs" asp-action="index" class="nav-link "><i class="bi bi-people-fill"></i>Curate Jobs</a></li>
           @*  <li class="nav-item"><a asp-controller="QuestionForms" asp-action="index" class="nav-link "><i class="bi bi-people-fill"></i>Survey</a></li>
            <li class="nav-item"><a asp-controller="OneMinute" asp-action="index" class="nav-link "><i class="bi bi-people-fill"></i>One Minute</a></li>
            <li class="nav-item"><a asp-controller="InterestingSnippet" asp-action="index" class="nav-link "><i class="bi bi-people-fill"></i>Interesting Snippet</a></li>
            <li class="nav-item"><a asp-controller="MyPoint" asp-action="index" class="nav-link "><i class="bi bi-briefcase-fill"></i>My Point</a></li> *@
            <li class="nav-item"><a asp-controller="Profiles" asp-action="index" class="nav-link "><i class="bi bi-people-fill"></i>User Porfiles</a></li>
            <li class="nav-item"><a asp-controller="Admin" asp-action="ManageJobs" class="nav-link "><i class="bi bi-briefcase-fill"></i> Manage Jobs</a></li>
           @*  <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#jobsMenu" role="button" aria-expanded="false" aria-controls="jobsMenu">
                    <span><i class="bi bi-briefcase"></i> Jobs</span>
                    <i class="bi bi-caret-down-fill small"></i>
                </a>
                <div class="collapse ms-3" id="jobsMenu">
                    <ul class="nav flex-column">
                        <li><a class="nav-link" href="/admin/curateJobs">Curated Job</a></li>
                       
                    </ul>
                </div>
            </li>
 *@
            

           

        </ul>
        <hr />
        <a asp-controller="Account" asp-area="/" asp-action="Logout" class="btn btn-outline-light w-100">Logout</a>
    </div>

    <!-- Content -->
    <div class="content d-flex flex-column">
        <nav class="navbar border-bottom px-3">
            <span class="navbar-text">
                Welcome, @User.Identity?.Name
                <button class="btn btn-outline-light d-md-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
                    <i class="bi bi-list" style="color:#000;"></i>
                </button>
            </span>
        </nav>
        <div class="col-md-2  d-md-block p-0">
            @Html.Partial("_SidebarAdmin")
        </div>
        <main class="p-2 p-md-4">
            @RenderBody()
        </main>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    @RenderSection("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Restore last open submenu
            let openMenu = localStorage.getItem("sidebar-open");
            if (openMenu) {
                let menu = document.querySelector(openMenu);
                if (menu) {
                    new bootstrap.Collapse(menu, { toggle: true });
                }
            }

            // Save submenu state when toggled
            document.querySelectorAll(".collapse").forEach(menu => {
                menu.addEventListener("shown.bs.collapse", function () {
                    localStorage.setItem("sidebar-open", "#" + this.id);
                });
                menu.addEventListener("hidden.bs.collapse", function () {
                    localStorage.removeItem("sidebar-open");
                });
            });
        });
    </script>

</body>

</html>
