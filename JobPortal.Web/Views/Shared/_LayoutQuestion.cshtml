    <style>
        /* Custom styles for animations */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fadeIn 0.5s ease-out forwards;
        }

        /* Ensure form steps are positioned correctly for the slide effect */
        .form-step-container {
            display: flex;
            transition: transform 0.5s ease-in-out;
        }

        .form-step {
            width: 100%;
            flex-shrink: 0; /* Prevents steps from shrinking */
        }

        .google-translate-fix-wrapper * {
            all: initial;
        }
        /* Step 2A: Use the "all: initial" property on all children within the wrapper */
        .google-translate-fix-wrapper * {
            /* Resets ALL inherited CSS properties (including display, margin, padding)
               to their initial values, effectively neutralizing Preflight. */
            all: initial;
            /* Re-apply basic flow properties lost by 'all: initial' */
            box-sizing: content-box;
            display: inline-block;
            vertical-align: middle;
        }

        /* Step 2B: Re-apply the specific Google Translate overrides */
        .goog-te-gadget {
            /* CRITICAL: Prevents any wrapping */
            white-space: nowrap !important;
            display: inline-block !important;
            margin: 0 !important;
            padding: 0 !important;
        }

            .goog-te-gadget .goog-te-combo
            {
                background-color: #00BD64 !important;
                color:#fff;
            }
        /* Ensure the main select element is explicitly inline and aligned */
        .goog-te-combo {
            display: inline-block !important;
            vertical-align: middle !important;
        }

        /* Target the logo/flag container to ensure it stays inline */
        .goog-te-gadget-combo {
            display: inline-block !important;
            vertical-align: middle !important;
        }

        /* Target all internal elements to ensure they behave inline and align */
        .goog-te-gadget > * {
            display: inline-block !important;
            vertical-align: middle !important;
            margin-right: 5px !important;
            padding: 0 !important;
        }

        @@media mediatype and (max-width:500px) {
            /* CSS rules to apply when the condition is met */


            .goog-te-gadget-combo {
                background-color: green !important;
                border: none !important;
            }

            .goog-te-gadget {
                display: flex;
            }
        }
    </style>

    @RenderSection("HeaderStyle", required: false)
