@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JobPortal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <link href="~/css/select2.min.css" rel="stylesheet" />
    <script src="~/js/select2.min.js"></script>
    <style>
        body {
            display: flex;
            min-height: 100vh;
        }

       

            .sidebar a {
                color: white;
                text-decoration: none;
            }

            .sidebar .nav-link.active {
                background-color: rgba(255,255,255,0.2);
            }

        .content {
            flex-grow: 1;
            background: #f8f9fa;
        }

        .navbar {
            background: white;
        }


        /* width for desktop sidebar */
        .sidebar {
            width: 250px;
            background: #198754;
            color: white;
            flex-shrink: 0;
            min-height: 100vh;
            position: sticky;
            top: 56px; /* if you have a fixed header of 56px height */
            overflow-y: auto;
        }

        /* ensure main content aligns when sidebar present */
        @@media (min-width: 768px) {
            #mainContent {
                padding-left: 1.5rem;
            }
        }

        /* ensure offcanvas body uses full height scroll */
        .offcanvas-body .nav {
            height: calc(100vh - 56px);
            overflow-y: auto;
        }

        .navbar-toggler {
            border: none !important;
        }

        .navbar-toggler-icon {
            border: none !important;
        }

        .navbar-toggler:focus {
            box-shadow: none !important;
        }
    </style>
    
</head>
<body>
    <!-- Sidebar -->
    
    <div class="d-none d-md-flex flex-column sidebar   text-white p-3" id="desktopSidebar" role="navigation">
        <h4 class="text-white">Job Portal</h4>
        <hr />
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li><a asp-controller="Profile" asp-action="index" class="nav-link text-white"><i class="bi bi-plus-circle"></i> Profile</a></li>
        
            <li><a asp-controller="Applications" asp-action="Index" class="nav-link text-white"><i class="bi bi-people"></i> Applications</a></li>

        </ul>
        <hr />
        <a asp-controller="Account" asp-area="/" asp-action="Logout" class="btn btn-outline-light w-100">Logout</a>
    </div>
    <!-- Content -->
    <div class="content d-flex flex-column">
        <nav class="navbar border-bottom px-3">
            <span class="navbar-text">
                Welcome, @User.Identity?.Name
                <button class="btn btn-outline-light d-md-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
                    <i class="bi bi-list" style="color:#000;"></i>
                </button>
            </span>
        </nav>
        <div class="col-md-2  d-md-block p-0">
            @Html.Partial("_SidebarEmployee")
        </div>
        <main class="p-2 p-md-4">
            @RenderBody()
        </main>
    </div>
  

  
 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
