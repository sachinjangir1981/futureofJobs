@model IEnumerable<JobPortal.Domain.Models.JobApplication>
@{ Layout = "/Views/Shared/_Layout.cshtml"; }
<h2>My Applications</h2>
<table class="table">
<thead><tr><th>Job</th><th>Applied On</th><th>Status</th></tr></thead>
<tbody>
@foreach(var a in Model) {
    <tr>
        <td>@a.Job?.Title</td>
        <td>@a.AppliedOn</td>
        <td>@a.Status</td>
    </tr>
}
</tbody>
</table>
