@using JobPortal.Web.Models;

@model List<OneMinuteItem>
@{
    ViewBag.Title = "Time Pass";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@section HeaderImage
{
    <div class="headerImage2">
    @*  <img src="~/images/employer.jpeg" /> *@
    </div>
}
<div class="bglogin" style="min-height:90vh; margin-top:-90px">
    @if (Model != null)
    {

        <div style="text-align:center;padding-top:65px">

            <span class="tpheading1" style="color:#3C467B;">Do You Get My Point</span> <br />
            <img src="~/images/dygmpmain.png" id="imgLogo" style=" max-width:100px" /><br />
            <span class="tpheading1">Future of Work</span><br />
            <div class="dygmpbg" style="height:2px; margin:5px 10px 0px 10px !important; "></div>
            <div class="dygmpbg" style="height:3px; margin:3px 10px 0px 10px !important"></div>
            <ul class="ulList">


                    @foreach (var itm in Model)
                    {
                    <li class="dygmpbg">
                            <a href="/visitor/MyPoint/@itm.PKID"> @Html.Raw(itm.Title) </a>
                        </li>
                    }
                </ul>
            </div>

         


    }
</div>