@using JobPortal.Web.Models;
@using System.Text.RegularExpressions

@model OneMinuteItem
@{
    ViewBag.Title = "One minute";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@section HeaderImage
{
    <div class="headerImage2">
        <img src="~/images/oneminutemain.png" />
    </div>
}

@{

    string whatispoint = Regex.Replace(Model.NewsSubject, "<.*?>", string.Empty);
    string deepdiving = Regex.Replace(Model.Discussion, "<.*?>", string.Empty);
    string thinkaboutit = Regex.Replace(Model.FeedBackLink, "<.*?>", string.Empty);
    string oneminute = Regex.Replace(Model.MediaRef, "<.*?>", string.Empty);
    int iwhatispoint = whatispoint.Length;
    int ideepdiving = deepdiving.Length;
    int ithinkaboutit = thinkaboutit.Length;
    int ioneminute = oneminute.Length;
}


<script src="https://code.jquery.com/jquery-3.7.0.min.js" integrity="sha256-2Pmvv0kuTBOenSvLm6bvfBSSHrUJ+3A7x6P5Ebd07/g=" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" type="text/javascript"></script>
 
<div class="container oneminutebg" style="margin-top:-90px">
@if (Model != null)
{

        <div class="row" style="padding-top:70px">
            
            <div class="col-12">
                <table width="100%" style="padding:0px 0px 0px 0px;">
                    <tr>

                        <td style="max-width:450px;" align="left">
                            <div id="html-content-holder" style="text-align:left;padding:0px 20px 20px 20px   ">
                                <div class="row" style="width:100%;margin:auto;  text-align:center">

                                    <div class="col-12 timepassheading1" style="color:#C40C0C; font-size:40px">
                                        One Minute
                                    </div>
                                    <span class="timepassheading2">Why We Work</span><br />
                                </div>
                                

                                <div class="row txt middlebg" style="padding-top:10px">
                                    <div class="paddingleftright5 margin0" style="text-align:left; padding-bottom:10px">
                                        <div class="sphead" style="font-size:17px; color:#000">
                                            @Html.Raw(Model.Title)
                                        </div> 
                                    </div>
                                    <div class="clearfix margin0"></div>
                                    @if (iwhatispoint > 0)
                                    {
                                        <div class=" margin0 paddingleftright5">
                                            <div class="sphead" style="color:#C40C0C">
                                                I Am Alert To…
                                            </div> @Html.Raw(Model.NewsSubject)
                                        </div>
                                        <div class="clearfix margin0"></div>
                                    }
                                    @if (ideepdiving > 0)
                                    {
                                        <div class="paddingleftright5">
                                            <div class="sphead" style="color:#C40C0C">
                                                I Am Impacted By…
                                            </div> @Html.Raw(Model.Discussion)
                                        </div>
                                        <div class="clearfix margin0"></div>
                                    }
                                    @if (ithinkaboutit > 0)
                                    {
                                        <div class="paddingleftright5">
                                            <div class="sphead" style="color:#C40C0C">
                                                I Am Rooting For…
                                            </div> @Html.Raw(Model.FeedBackLink)
                                        </div>
                                        <div class="clearfix margin0"></div>
                                    }
                                    @if(ioneminute > 0)
                                    {
                                        <div class="paddingleftright5">
                                            <div class="sphead" style="color:#C40C0C">
                                            One Minute!
                                        </div> @Html.Raw(Model.MediaRef)
                                    </div>
                                    }

                                </div>
                                
                            </div>
                            <div class="col-lg-12 col-md-12" style="text-align:center;padding-top:5px">
                                <div style="text-align:center; display:inline-flex">
                                    <a href="javascript:void(0)"><img src="~/images/download1.png" width="32" onclick="createimage()" id="btnConvert" alt="Download" /></a>
                                    <a target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=@Html.Encode("https://greenjobs.digital/visitor/OneMinute/"+@Model.PKID)&title=@Html.Encode("Hello Kisan")&description=@Html.Encode("Hello Kisan: OneMinute")"><img src="~/images/facebook.png" width="32" /> </a>
                                    <a target="_blank" href="https://wa.me/?text=@Html.Encode("Hello Kisan: OneMinute")%20https://greenjobs.digital/visitor/OneMinute/@Model.PKID"><img src="~/images/whatsapp.png" width="32" /> </a>
                                    <a target="_blank" href="https://www.linkedin.com/shareArticle?mini=true&url=https://greenjobs.digital/visitor/OneMinute/@Model.PKID&title=@Html.Encode("Hello Kisan")&summary=@Html.Encode("Hello Kisan: OneMinute")&source=hellokisan.org"><img src="~/images/linkedin.png" width="32" /> </a>
                                    <a href="mailto:?subject=Hello Kisan: OneMinute&body=https://greenjobs.digital/visitor/OneMinute/@Model.PKID"><img src="~/images/mail.png" width="32" /> </a>
                                </div>

                            </div>
                        </td>

                    </tr>
                    <tr>
                        <td align="center" style="display:none">
                            <img src="~/images/prev_button.png" id="imgPrev" onclick="gotopreviousItem()" style="margin-right:10px; top: 50%;" class="" />
                            <img src="~/images/next_button.png" id="imgNext" onclick="gotonextItem()" style="margin-left:10px" class="" />
                        </td>

                    </tr>
                </table>
            </div>
            
            <div style="display:none">
                <div id="previewImg">
                </div>
            </div>
        </div>
    
}

</div>


<script>
    var totalItem = parseInt(1);
    var currentItem = parseInt(1);

    if (currentItem == 1) {
        $('#imgPrev').hide();
    }

    if (currentItem >= totalItem) {
        $('#imgNext').hide();
    }
    if (currentItem > 1) {
        $('#imgPrev').show();
    }

    if (totalItem > currentItem) {
        $('#imgNext').show();
    }

    function gotopreviousItem() {
        if (currentItem == 1) {
            $('#imgPrev').hide();
            console.log("already at first place");
        }
        else {
            currentItem = currentItem - 1;
            location.href = "/Home/OneMinute/?i=" + currentItem;

        }
    }

    function gotonextItem() {
        if (currentItem == totalItem) {
            $('#imgNext').hide();
            console.log("already at last place");
        }
        else {
            currentItem = currentItem + 1;
            location.href = "/Home/OneMinute/?i=" + currentItem;
        }

    }

    function createimage() {
        html2canvas(document.getElementById("html-content-holder")).then(function (canvas) {
            var anchorTag = document.createElement("a");
            document.body.appendChild(anchorTag);
            document.getElementById("previewImg").appendChild(canvas);
            anchorTag.download = "filename.jpg";

            anchorTag.href = canvas.toDataURL();
            anchorTag.target = '_blank';
            anchorTag.click();
            $('#previewImg').text('');
            //var fakeLink = document.createElement('a');
            //fakeLink.setAttribute('href', 'https://wa.me/send?text='+encodeURIComponent('http://cards.spavitechnology.com/images/head.png'));
            //fakeLink.setAttribute('data-action', 'share/whatsapp/share');
            //fakeLink.target = '_blank';
            //console.log('hi');
            //fakeLink.click();
        });
    };
</script>
