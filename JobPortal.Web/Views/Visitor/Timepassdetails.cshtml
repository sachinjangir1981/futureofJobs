@using JobPortal.Web.Models;

 
@{
    ViewBag.Title = "Trending News";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@section HeaderImage
{
    <div class="headerImage2">
        <img src="~/images/timepass.png" />
    </div>
}

<script src="https://code.jquery.com/jquery-3.7.0.min.js" integrity="sha256-2Pmvv0kuTBOenSvLm6bvfBSSHrUJ+3A7x6P5Ebd07/g=" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>



<div class="container bgsunset" style="margin-top:-90px">
        <div class="row" style="padding-top:90px">
            <div class="col-12">
                <table width="100%" style="padding:0px 10px 0px 10px">
                    <tr>

                        <td style="max-width:450px;" align="left">
                            <div id="html-content-holder" style="text-align:left  ">

                                <div class="row" style="width:100%;margin:auto;  text-align:left">

                                    <div class="col-12 timepassheading1" style="color:#fff; font-size:20px;">
                                        TIME PASS @*  <span class="timepassheading2">Learning Life Lessons</span><br /> *@
                                    </div>
                                   
                                </div>
                                

                                <div class="row txt" style="padding-left:20px; ">
                                    <div class="row margin10">
                                    <p class="paraCommon" style="font-size:22px;"><b>Because real learning often happens when you’re not trying too hard</b> </p><p class="paraCommon">
                                        Let’s be honest.
                                    </p><p class="paraCommon">
                                        Some of the most important lessons in life were never taught in classrooms.
                                    </p><p class="paraCommon">
                                        They happened while waiting.
                                    </p><p class="paraCommon">
                                        While helping someone.
                                    </p><p class="paraCommon">
                                        While organizing something messy.
                                    </p><p class="paraCommon">
                                        While failing publicly.
                                    </p><p class="paraCommon">
                                        While doing something that looked like time pass… but wasn’t.
                                    </p><p class="paraCommon">
                                        <b>Time Pass</b> is a fun corner of this website where every day experiences quietly turn into life lessons. No syllabus. No exams. No Gyaan.
                                    </p><p class="paraCommon">
                                        Just short, relatable stories drawn from home, campus life, streets, communities, festivals, friendships, mistakes, experiments, awkward moments - and those “oh, now I get it” realizations.
                                    </p><p class="paraCommon">
                                        <b>Each “Time Pass” starts small.</b>
                                    </p><p class="paraCommon">
                                        A task. A situation. A challenge.
                                    </p><p class="paraCommon">
                                        Nothing heroic. Nothing dramatic.
                                    </p><p class="paraCommon">
                                        But somewhere between “yeh kya tha?” and “accha… interesting”, something clicks.
                                    </p><p class="paraCommon">
                                        You’ll see stories about:
                                    </p><p class="paraCommon">
                                        •	organizing things without authority
                                        •	dealing with people, pressure, confusion, emotions
                                        •	learning responsibility without being told
                                        •	understanding systems, culture, money, taste, time, and yourself
                                        Read one. Or binge ten.
                                    </p><p class="paraCommon">
                                        There’s no correct order, no score, no outcome promised.
                                    </p><p class="paraCommon">
                                        This section is not about becoming successful.
                                    </p><p class="paraCommon">
                                        It’s about becoming <b>a little more sorted</b> - without trying too hard.
                                    </p><p class="paraCommon">
                                        Scroll ahead.
                                    </p><p class="paraCommon">
                                        Pick a Time Pass.
                                    </p><p class="paraCommon">
                                        Who knows—one of them might quietly explain something about your own life.
                                    </p><p class="paraCommon">
                                        <b><i>Warning: May cause unexpected “haan yaar, yeh toh mere saath bhi hua tha” moments.</i></b>
                                    </p><p class="paraCommon">
                                        <b>My honest take:</b>
                                    </p><p class="paraCommon">
                                        If more young people learned life this way through playful responsibility instead of forced seriousness - we’d have calmer professionals, kinder leaders, and fewer “degree but no sense” situations.
                                    </p> 
                                </div>
                                    <div class="clearfix margin10"></div>
                                    
                                  


                                </div>

                            </div>
                            <div class="col-lg-12 col-md-12" style="text-align:center; padding-top:5px;padding-bottom:10px;">
                                <div style="text-align:center; display:inline-flex">
                                    <a href="javascript:void(0)"><img src="~/images/download1.png" width="32" onclick="shareOnWhatsApp()" id="btnConvert" alt="Download" /></a>
                                    <a target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=@Html.Encode("http://hellokisan.org/visitor/TimePass/")&title=@Html.Encode("Hello Kisan")&description=@Html.Encode("Hello Kisan: Timepass")"><img src="~/images/facebook.png" width="32" /> </a>
                                    <a target="_blank" href="https://wa.me/?text=@Html.Encode("Hello Kisan: Timepass")%20http://hellokisan.org/visitor/TimePass/"><img src="~/images/whatsapp.png" width="32" /> </a>
                                    <a target="_blank" href="https://www.linkedin.com/shareArticle?mini=true&url=http://hellokisan.org/visitor/TimePass/&title=@Html.Encode("Hello Kisan")&summary=@Html.Encode("Hello Kisan: Timepass")&source=hellokisan.org"><img src="~/images/linkedin.png" width="32" /> </a>
                                    <a href="mailto:?subject=Hello Kisan: Timepass&body=http://hellokisan.org/visitor/TimePass/"><img src="~/images/mail.png" width="32" /> </a>
                                </div>

                            </div>
                            <div id="fttext" style="padding-bottom:20px;"> </div>
                        </td>

                    </tr>
                    <tr>
                        <td align="center" style="display:none">
                            <img src="~/images/prev_button.png" id="imgPrev" onclick="gotopreviousItem()" style="margin-right:10px; top: 50%;" class="" />
                            <img src="~/images/next_button.png" id="imgNext" onclick="gotonextItem()" style="margin-left:10px" class="" />
                        </td>

                    </tr>
                </table>
            </div>

            <div style="display:none">
                <div id="previewImg">
                </div>
            </div>
        </div>
    </div>
 




<script>
    var totalItem = parseInt(1);
    var currentItem = parseInt(1);

    if (currentItem == 1) {
        $('#imgPrev').hide();
    }

    if (currentItem >= totalItem) {
        $('#imgNext').hide();
    }
    if (currentItem > 1) {
        $('#imgPrev').show();
    }

    if (totalItem > currentItem) {
        $('#imgNext').show();
    }

    function gotopreviousItem() {
        if (currentItem == 1) {
            $('#imgPrev').hide();
            console.log("already at first place");
        }
        else {
            currentItem = currentItem - 1;
            location.href = "/Home/TimePass/?i=" + currentItem;

        }
    }

    function gotonextItem() {
        if (currentItem == totalItem) {
            $('#imgNext').hide();
            console.log("already at last place");
        }
        else {
            currentItem = currentItem + 1;
            location.href = "/Home/TimePass/?i=" + currentItem;
        }

    }

    function createimage() {
        html2canvas(document.getElementById("html-content-holder")).then(function (canvas) {
            var anchorTag = document.createElement("a");
            document.body.appendChild(anchorTag);
            document.getElementById("previewImg").appendChild(canvas);
            anchorTag.download = "filename.jpg";

            anchorTag.href = canvas.toDataURL();
            anchorTag.target = '_blank';
            anchorTag.click();
            $('#previewImg').text('');
            //var fakeLink = document.createElement('a');
            //fakeLink.setAttribute('href', 'https://wa.me/send?text='+encodeURIComponent('http://cards.spavitechnology.com/images/head.png'));
            //fakeLink.setAttribute('data-action', 'share/whatsapp/share');
            //fakeLink.target = '_blank';
            //console.log('hi');
            //fakeLink.click();
        });
    };
</script>

<script src="~/js/share.js"></script>