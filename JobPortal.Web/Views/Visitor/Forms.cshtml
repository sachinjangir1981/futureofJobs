@section Scripts
{
    <script src="~/js/multi-step-form.js"></script>


    <script>

        function afterLogin()
        {
             $("#myPopup").hide();
                $('#overlay').hide();
             $('#submit-button').show();
        }

        document.addEventListener('DOMContentLoaded', () => {

          var stepId = @ViewBag.StepId;
          if(stepId == null || stepId == 0)
          {
              stepId = 1;
          }
          else
          {
             $("#prev-button").hide();
             $('#next-button').hide()
             $('#submit-button').show()
             $('#review-button').hide()
              animatedbg();
          }

        });
        function animatedbg(){
            $('.form-step').hide();
             $('#dvReview').show();

            // Get the container for the dots
            const dotCurtain = document.getElementById('dot-curtain');

            // --- Customizable Parameters ---
            const numberOfDots = 400; // Total number of dots on the screen (Increased for denser impression)
            // Array of lighter grey/pastel colors for multi-color dots
            const dotColors = [
                'rgba(200, 200, 200, 0.6)', // Light Grey
                'rgba(173, 216, 230, 0.6)', // Light Blue (similar to previous)
                'rgba(255, 223, 186, 0.6)', // Pale Peach
                'rgba(186, 255, 186, 0.6)', // Pale Green
                'rgba(230, 190, 230, 0.6)'  // Pale Purple
            ];
            const minDotSize = 2; // Minimum dot size in pixels
            const maxDotSize = 8; // Maximum dot size in pixels
            const dotSpeed = 0.4; // Speed of dots moving left to right (pixels per frame)
            const waveAmplitude = 40; // Max vertical displacement for the wave effect (pixels)
            const waveFrequency = 0.005; // How spread out the waves are (smaller = more spread out)
            const dispersionFactor = 0.001; // Controls how much dots gather/disperse based on their X position
            // --- End Customizable Parameters ---

            let dots = []; // Array to hold all dot elements
            let animationFrameId; // To store the requestAnimationFrame ID
            let time = 0; // Global time variable for wave calculation

            // Function to create and initialize a single dot element
            function createDot() {
                const dot = document.createElement('div');
                dot.classList.add('dot');

                // Set initial random size and color
                const size = Math.random() * (maxDotSize - minDotSize) + minDotSize;
                dot.style.width = `${size}px`;
                dot.style.height = `${size}px`;

                // Randomly pick a color from the dotColors array
                const randomColor = dotColors[Math.floor(Math.random() * dotColors.length)];
                dot.style.backgroundColor = randomColor;

                // Store dot properties for animation
                // x and y are the current positions, initialY is the baseline for wave
                dot.x = Math.random() * window.innerWidth;
                dot.y = Math.random() * window.innerHeight;
                dot.initialY = dot.y;

                // Random phase offset for each dot's wave to make it look less uniform
                dot.waveOffset = Math.random() * Math.PI * 2;
                // Random multiplier for wave amplitude to create varying wave intensity
                dot.amplitudeMultiplier = 0.5 + Math.random() * 0.5; // From 0.5 to 1.0

                // Append dot to the curtain container
                dotCurtain.appendChild(dot);
                dots.push(dot);

                // Smoothly fade in the dot after a short random delay
                setTimeout(() => dot.style.opacity = 1, Math.random() * 800);
            }

            // Populate the curtain with dots
            for (let i = 0; i < numberOfDots; i++) {
                createDot();
            }

            // The main animation loop using requestAnimationFrame for smoothness
            function animate() {
                // Increment global time for wave progression
                time += 0.01;

                dots.forEach(dot => {
                    // Move dot from left to right
                    dot.x += dotSpeed;

                    // Calculate the vertical position (Y) to create the wave effect
                    // Combines global time, dot's X position, and individual wave offsets
                    const currentWaveAmplitude = waveAmplitude * dot.amplitudeMultiplier;
                    const waveY = Math.sin(dot.x * waveFrequency + dot.waveOffset + time) * currentWaveAmplitude;

                    // Add a dispersion/gathering effect:
                    // Introduce a slight additional Y offset based on X position to make dots
                    // appear to gather and disperse in "blocks"
                    const dispersionY = Math.sin(dot.x * dispersionFactor) * (currentWaveAmplitude * 0.5);

                    dot.y = dot.initialY + waveY + dispersionY;

                    // If dot moves off the right side of the screen, reset its position to the left
                    if (dot.x > window.innerWidth + maxDotSize) {
                        dot.x = -maxDotSize; // Reset to just off the left edge
                        dot.initialY = Math.random() * window.innerHeight; // New random initial Y for variety
                        dot.waveOffset = Math.random() * Math.PI * 2; // New random wave phase
                        dot.amplitudeMultiplier = 0.5 + Math.random() * 0.5; // New random amplitude multiplier
                    }

                    // Apply the new position using CSS transform for performance
                    dot.style.transform = `translate(${dot.x}px, ${dot.y}px)`;
                });

                // Request the next animation frame
                animationFrameId = requestAnimationFrame(animate);
            }

            // Start the animation as soon as the DOM is ready (moved from window.onload)
            animate();

            // Handle window resizing: Adjust initial dot positions if they are out of bounds
            window.addEventListener('resize', () => {
                dots.forEach(dot => {
                    // If a dot's x or y is now outside the new window dimensions, reposition it
                    if (dot.x > window.innerWidth || dot.y > window.innerHeight) {
                        dot.x = Math.random() * window.innerWidth;
                        dot.y = Math.random() * window.innerHeight;
                        dot.initialY = dot.y; // Update initialY for new baseline
                    }
                    // Ensure transform is applied after resize
                    dot.style.transform = `translate(${dot.x}px, ${dot.y}px)`;
                });
            });
        };
    </script>



    }
