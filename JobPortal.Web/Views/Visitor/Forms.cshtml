 @using JobPortal.Web.Models;

@model DynamicForm
@{
    ViewBag.Title = "Question";
    Layout = "~/Views/Shared/_LayoutQuestion.cshtml";

    List<DAnswerRecord> recordedAnswer = ViewBag.RecordedAnser;
    int iSheetCount = 0;
    int totalSections = Model.Sections.Count;
    int i = 0;
    int j = 0;
    string divclass = "animate-fade-in";

    string SurveyFormatHeaderBG = "background-color:" + Model.CommonCSS.SurveyFormatHeaderBG ?? "#ffffff";
    string SurveyFormatHeadDetailsBG = "background-color:" + Model.CommonCSS.SurveyFormatHeadDetailsBG ?? "#ffffff";
    string SurveyFormatFooterBG = "background-color:" + Model.CommonCSS.SurveyFormatFooterBG ?? "#ffffff";
    string SurveyFormatSectionBG = "background-color:" + Model.CommonCSS.SurveyFormatSectionBG ?? "#ffffff";
    string SurveyFormatSectionDetailsBG = "background-color:" + Model.CommonCSS.SurveyFormatSectionDetailsBG ?? "#ffffff";
    string SurveyFormatSectionFooterBG = "background-color:" + Model.CommonCSS.SurveyFormatSectionFooterBG ?? "#ffffff";
    string QuestionBG = "background-color:" + Model.CommonCSS.QuestionBG ?? "#ffffff";
    string AnswerBG = " background-color:" + Model.CommonCSS.AnswerBG ?? "#ffffff";
    string bgImage = "/images/dforms/" + (string.IsNullOrEmpty(Model.BGUrl) == true ? "default_bg.jpg" : Model.BGUrl);

//     Model.User.IsBootStrap = false;
 }

@section HeaderStyle {
    <link href="~/css/radiobtncss.css" rel="stylesheet" />
    <link href="~/css/register.css" rel="stylesheet" />
    <style>
        body {
            background-image: url('@bgImage') !important;
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-position: center;
            font-family: Math Calibri;
            font-size: 18px;
            /* font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji" !important; */
        }

        .sheetheading {
            font-size: 28px;
            text-align: center;
            font-weight: 600;
            padding: 2px;
        }

        .sectionheading {
            font-size: 24px;
            text-align: left;
            font-weight: 600;
            padding: 2px;
        }

        .font-sans {
            /*  font-family: system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans","Liberation Sans",sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji"; */
            font-family: "Times New Roman", Times, serif !important;
        }
      

        @@media only screen and (max-width: 480px) {
            .options {
                
                margin-top: 10px;
                display: block;
                clear: both;
            }

            .paddinglr10
            {
                padding-left:10px !important;
                padding-right: 10px !important;
            }
        }

        @@media only screen and (min-width: 480px) {
            .options {
                margin-top: 10px;
                display: block;
                clear: both;
            }
        }

    </style>
   }

<div style="@SurveyFormatHeaderBG">
    <div class="grid grid-cols-5 p-2">
        <div class="rounded-full">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="~/images/dforms/@Model.ImageUrlLeft" style="width:50px; height :50px" />
            }
        </div>
        <div class="col-span-3 text-center">
            @*   <div class="mb-2 p-2 text-center "> *@
            <h1 class=" mb-2 sheetheading" style="@SurveyFormatHeaderBG"> @Model.Title</h1>


            @*  </div> *@
        </div>
        <div class="rounded-full">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="~/images/dforms/@Model.ImageUrl" style="width:50px; height :50px;float:right" />
            }

        </div>

    </div>

</div>

<div style="@SurveyFormatHeadDetailsBG">
    <div style="padding-left:10px !important; padding-right:10px !important;">@Html.Raw(Model.Header)</div>
</div>
<div class="mb-1 text-center"  >
    <p style="@SurveyFormatHeadDetailsBG" class="text-gray-600 p-1" id="step-indicator">Step 1 of 4</p>
</div>
<div class="w-full  rounded-full h-2.5 "  >
    <div id="progress-bar" class="bg-green-600 h-1.5 rounded-full transition-all duration-500 ease-in-out" style="width: 25%;"></div>
</div>

<div class="overflow-hidden relative">
    <form id="frmForms" name="frmForms" asp-action="Forms" asp-controller="Visitor" enctype="multipart/form-data" method="post">
        @foreach (var formsection in Model.Sections)
        {
            iSheetCount++;
            j = 0;
            var steps = formsection.Questions.DistinctBy(mbox => mbox.Step).ToList();
            //var sectionRecordedAnswer = recordedAnswer.Where(x => x.SectionId == formsection.PKID).ToList();

            string formid = "frm" + formsection.PKID;

            <div id="form-step-container" class="form-step-container" style="max-height:450px;  overflow-y:scroll">
                @Html.HiddenFor(m => formsection.PKID)

                @foreach (var step in steps)
                {
                    var stepquestions = formsection.Questions.Where(x => x.Step == step.Step).ToList();
                    i++;
                    j++;
                    if (i > 1)
                    {
                        divclass = "hidden";
                    }
                    else
                    {
                        divclass = "animate-fade-in";
                    }
                    <div id="step-@i" class="form-step   @divclass ">
                        <div class="mb-1"  >
                            <h3 class="mb-1 p-1 sectionheading paddinglr10" style="@SurveyFormatSectionBG">@formsection.Section</h3>
                            <div style="@SurveyFormatSectionDetailsBG" class="p-1 paddinglr10">  @Html.Raw(formsection.Detail)</div>
                        </div>

                        @foreach (var question in stepquestions)
                        {
                            <div class="mb-1 p-1" style="@QuestionBG">
                                <label for="name" class="text-gray-700 mb-2" style="width:100%;padding-left:10px; padding-right:10px;">
                                    @Html.HiddenFor(m => question.PKID)
                                    @Html.HiddenFor(m => question.QuestionType)
                                    @Html.Raw(question.Question)
                                </label>
                                @if (question.QuestionType == 1)
                                {
                                    <div class="p-2 options" style="@AnswerBG">
                                        @foreach (var answer in question.Answers)
                                        {
                                            string answerId = question.PKID.ToString() + "_" + answer.PKID.ToString();
                                            <div style="display:block;" class="custom-radio-group">
                                                @Html.RadioButton(question.PKID.ToString(), answer.PKID.ToString(), new { @id = answerId })

                                                <label for="@answerId" style="display:inline-block" class="text-gray-700 text-sm   mb-2">@Html.Raw(answer.Answer)</label>
                                            </div>

                                        }
                                    </div>
                                }
                                else if (question.QuestionType == 2)
                                {
                                    <div class="p-2  options" style="width:100%; display:inline-block; @AnswerBG">
                                        @foreach (var answer in question.Answers)
                                        {
                                            string answerId = question.PKID.ToString() + "_" + answer.PKID.ToString();
                                            <div style="display:block;">
                                                <label class="checkbox-container">
                                                    @Html.Raw(answer.Answer)
                                                    <input id="@answerId" value="@answer.PKID.ToString()" style="margin:4px" type="checkbox" name="@question.PKID" />
                                                    <span class="checkmark"></span>
                                                </label>

                                                @*  

                                                <input id="@answerId" value="@answer.PKID.ToString()" style="margin:4px" type="checkbox" name="@question.PKID" />
                                                <label for="@answerId" class="text-gray-700 text-sm   mb-2">@Html.Raw(answer.Answer)</label>
                                            *@
                                            </div>
                                        }
                                    </div>

                                }
                                else if (question.QuestionType == 3)
                                {
                                    var answer = question.Answers[0];
                                    string answerId = question.PKID.ToString() + "_" + answer.PKID.ToString();
                                    <div class="p-4  options" style="@AnswerBG">
                                        <input id="@answerId" type="range" min="@answer.RMin" max="@answer.RMax" value="@answer.Rincrement" class="form-range shadow appearance-none border border-gray-300 rounded-xl w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" />
                                    </div>
                                }
                                else if (question.QuestionType == 4)
                                {
                                    string answerId = question.PKID.ToString();
                                    <div class="p-1  options" style="@AnswerBG">
                                        <input id="@answerId" name="@answerId" type="text" class="shadow appearance-none border border-gray-300 rounded-xl w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" />
                                    </div>
                                }
                                else if (question.QuestionType == 5)
                                {
                                    string answerId = question.PKID.ToString();
                                    <div class="p-1  options" style="@AnswerBG">
                                        <input id="@answerId" name="@answerId" type="file" class="shadow appearance-none border border-gray-300 rounded-xl w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200" />
                                    </div>
                                }

                                @* <input type="text" id="name" name="name" placeholder="Enter full name"
                                       class="shadow appearance-none border border-gray-300 rounded-xl w-full py-3 px-4 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"> *@
                                <p class="text-red-500 text-xs italic mt-2 hidden" id="error-name"></p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(formsection.Footer))
                        {
                            <div class="mb-8 p-1 sectionfooter paddinglr10" style="@SurveyFormatSectionFooterBG">

                                <p>  @Html.Raw(formsection.Footer)</p>
                            </div>
                        }

                    </div>


                }



            </div>

        }

        <input type="hidden" id="hidBtnclickfrom" name="hidBtnclickfrom" value="0" />


    </form>
    @if (iSheetCount == totalSections)
    {
        i++;
        <div>
            <div id="dvReview" class="hidden" style="max-height:450px;  overflow-y:scroll">


                <div class="mb-1">
                    <h3 class="mb-1 p-1 sectionheading text-center">Review</h3>

                    @foreach (var formsection in Model.Sections)
                    {
                        iSheetCount++;
                        j = 0;
                        var steps = formsection.Questions.DistinctBy(mbox => mbox.Step).ToList();
                        var sectionRecordedAnswer = recordedAnswer.Where(x => x.SectionId == formsection.PKID).ToList();

                        string formid = "frm" + formsection.PKID;


                        @Html.HiddenFor(m => formsection.PKID)

                        @foreach (var step in steps)
                        {
                            var stepquestions = formsection.Questions.Where(x => x.Step == step.Step).ToList();

                            i++;
                            j++;
                            if (i > 1)
                            {
                                divclass = "hidden";
                            }
                            else
                            {
                                divclass = "animate-fade-in";
                            }

                            <div class="mb-1">
                                <h3 class="mb-1 p-1 sectionheading" style="@SurveyFormatSectionBG">@formsection.Section</h3>

                            </div>

                            @foreach (var question in stepquestions)
                            {
                                var itm = sectionRecordedAnswer.Count > 0 ? sectionRecordedAnswer.Where(q => q.QuestionId == question.PKID).FirstOrDefault() : null;
                                string questionanswer = itm != null ? itm.Answer : "";
                                <div class="mb-1 p-1" style="@QuestionBG">
                                    <label for="name" class="block text-gray-700 mb-2">
                                        <b>Question : @Html.Raw(question.Question)</b>
                                    </label>
                                    @if (question.QuestionType == 1)
                                    {
                                        <div class="p-2" style="@AnswerBG">
                                            @foreach (var answer in question.Answers)
                                            {
                                                string answerId = question.PKID.ToString() + "_" + answer.PKID.ToString();
                                                <div style="display:block;" class="custom-radio-group">
                                                    @Html.RadioButton(question.PKID.ToString(), answer.PKID.ToString(), new { @id = answerId })

                                                    <label for="@answerId" style="display:inline-block" class="text-gray-700 text-sm   mb-2">@Html.Raw(answer.Answer)</label>
                                                </div>

                                            }
                                        </div>

                                        <div class="dvReviewAnswer">
                                            Your Answer:  @Html.Raw(questionanswer)
                                        </div>
                                    }
                                    else if (question.QuestionType == 2)
                                    {
                                        <div class="p-2" style="width:100%; display:inline-block; @AnswerBG">
                                            @foreach (var answer in question.Answers)
                                            {
                                                string answerId = question.PKID.ToString() + "_" + answer.PKID.ToString();
                                                <div style="display:block;">
                                                    <label class="checkbox-container">
                                                        @Html.Raw(answer.Answer)
                                                        <input id="@answerId" value="@answer.PKID.ToString()" style="margin:4px" type="checkbox" name="@question.PKID" />
                                                        <span class="checkmark"></span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                        <div class="dvReviewAnswer">
                                            Your Answer:   @Html.Raw(questionanswer)
                                        </div>
                                    }
                                    else if (question.QuestionType == 3)
                                    {
                                        var answer = question.Answers[0];
                                        string answerId = question.PKID.ToString() + "_" + answer.PKID.ToString();

                                        <div class="dvReviewAnswer">
                                            Your Answer:   @Html.Raw(questionanswer)
                                        </div>
                                    }
                                    else if (question.QuestionType == 4)
                                    {
                                        string answerId = question.PKID.ToString();

                                        <div class="dvReviewAnswer">
                                            Your Answer:   @Html.Raw(questionanswer)
                                        </div>
                                    }
                                    else if (question.QuestionType == 5)
                                    {
                                        string answerId = question.PKID.ToString();

                                        <div class="dvReviewAnswer">
                                            Your Answer:  <img src="@questionanswer" width="100" height="70" />
                                        </div>
                                    }


                                </div>
                            }

                        }





                    }

                </div>
            </div>
        </div>
    }

</div>

