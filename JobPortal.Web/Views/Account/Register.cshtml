    </div>
}
<form id="frmLoginregister" method="post">
    <div class="bgregister row" style=" margin-top:-90px; padding:20px 10px 50px 10px; height:99vh;">

        <div class="col-md-12 col-sm-12 col-xs-12" style="height:95vh; overflow-y:auto; padding-bottom:50px; margin-top:60px;padding-left:8%; padding-right:8%;">

            @Html.ValidationSummary(true, "Please fix the following errors.", new { @class = "text-danger" })
            <div class="mb-3">
