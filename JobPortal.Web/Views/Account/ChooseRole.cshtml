@{ Layout = "/Views/Shared/_Layout.cshtml"; }
<h2>Choose Account Type</h2>
<form method="post">
  <div class="mb-3">
    <label>Select account type</label>
    <select name="role" class="form-control"><option value="JobSeeker">Job Seeker</option><option value="Employer">Employer</option></select>
  </div>
  <button class="btn btn-primary" type="submit">Continue</button>
</form>
