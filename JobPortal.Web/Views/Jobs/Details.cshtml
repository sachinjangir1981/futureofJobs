@using JobPortal.Web.Models
@model JobPortal.Domain.Models.Job
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    string hl = Context.Request.Query["hl"];
}
<h2>@HighlightHelper.HighlightText(Model.Title, hl)</h2>
<p><strong>Location:</strong> </p>
<div>@HighlightHelper.HighlightHtml(Model.Description, hl)</div>
<form method="post" action="/Applications/Apply">
    <input type="hidden" name="jobId" value="@Model.Id" />
    <button class="btn btn-primary mt-3" type="submit">Apply</button>
</form>
