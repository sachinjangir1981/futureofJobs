@model IEnumerable<JobPortal.Domain.Models.Job>
@{ Layout = "/Views/Shared/_Layout.cshtml";
    //@Request.Query["q"]
 }
<h2>Jobs</h2>
<form method="get" class="mb-3">
    <div class="input-group">
        <input class="form-control" name="q" placeholder="Search jobs..." value="" /> 
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>
<div class="row">
@foreach(var j in Model) {
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@j.Title</h5>
                
                <a class="btn btn-sm btn-primary" href="/Jobs/Details/@j.Id">View</a>
            </div>
        </div>
    </div>
}
</div>
