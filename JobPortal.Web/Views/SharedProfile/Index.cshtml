@using JobPortal.Web.AdminForms
@using JobPortal.Domain.Models
@model AdminUserSubmissionsDetail
@{
    Layout = null;

    List<string> stExt = new List<string>();
    stExt.Add("jpg");
    stExt.Add("png");
    stExt.Add("jpeg");
    stExt.Add("gif");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@Model.UserName - Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container py-4" style="max-width:900px;">
        <div class="alert alert-secondary small">
            This is a time-limited shared view. It is not indexed or listed publicly, and expires automatically.
        </div>

        <h2>@Model.UserName</h2>
        <p class="text-muted mb-4">&lt;@Model.Email&gt;</p>

        @if (!Model.Forms.Any())
        {
            <div class="alert alert-warning">No form data available for this link.</div>
        }

        @foreach (var frm in Model.Forms)
        {
            <h4 class="mt-4">@frm.FormName</h4>
            @if (!frm.Sections.Any())
            {
                <div class="alert alert-warning">No sections found for this form.</div>
            }
            @foreach (var sec in frm.Sections)
            {
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <strong>@sec.Title</strong>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:45%;">Question</th>
                                    <th>Answer</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in sec.Questions)
                                {
                                    var isAnswered = q.QuestionType == QuestionType.FileUpload ? !string.IsNullOrEmpty(q.FilePath) : !string.IsNullOrEmpty(q.DisplayAnswer);
                                    <tr>
                                        <td>
                                            @Html.Raw(q.QuestionText)
                                            @if ((q.QuestionType == QuestionType.SingleChoice || q.QuestionType == QuestionType.MultipleChoice) && q.Options.Any())
                                            {
                                                <div class="text-muted small mt-1">
                                                    Options: @Html.Raw(string.Join(", ", q.Options.Select(o => o.OptionText)))
                                                </div>
                                            }
                                        </td>
                                        <td class="@(isAnswered ? "text-success" : "text-danger")">
                                            @if (q.QuestionType == QuestionType.FileUpload)
                                            {
                                                if (!string.IsNullOrEmpty(q.FilePath))
                                                {
                                                    string fileext = q.FilePath.ToLower().Substring(q.FilePath.LastIndexOf(".") + 1);

                                                    string st = "https://futureofjobs.digital" + q.FilePath

;                                                    int i = stExt.FirstOrDefault(x => x == fileext).Count();
                                                    if (i > 0)
                                                    {
                                                        <img src="@st" + width="100" height="100" />
                                                    }
                                                    <a href="@st" target="_blank">View uploaded file</a>
                                                }
                                                else
                                                {
                                                    <span>No file uploaded</span>
                                                }
                                            }
                                            else if (string.IsNullOrEmpty(q.DisplayAnswer))
                                            {
                                                <span>No answer</span>
                                            }
                                            else if (q.QuestionType == QuestionType.SingleChoice || q.QuestionType == QuestionType.MultipleChoice)
                                            {
                                                @Html.Raw(q.DisplayAnswer)
                                            }
                                            else
                                            {
                                                @q.DisplayAnswer
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</body>
</html>
